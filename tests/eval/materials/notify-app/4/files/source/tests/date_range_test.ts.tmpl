import { assertEquals } from "@std/assert";
import { formatLocal, toDate, weekRange } from "../src/date-range/mod.ts";

Deno.test("date-range: toDate rejects a day that does not exist and keeps one that does", () => {
  const base = { year: 2026, month: 2, day: 30, hour: 9, minute: 0 };
  assertEquals(toDate(base), null);
  assertEquals(toDate({ ...base, day: 28, hour: 24 }), null);
  const date = toDate({ ...base, day: 28 });
  assertEquals(date && formatLocal(date), "2026-02-28T09:00");
});

Deno.test("date-range: weekRange starts on Monday 00:00 and ends on the next Monday", () => {
  // 2026-07-15는 수요일이다.
  const wednesday = new Date(2026, 6, 15, 13, 30);
  const week = weekRange(wednesday, 0);
  assertEquals(formatLocal(week.from), "2026-07-13T00:00");
  assertEquals(formatLocal(week.to), "2026-07-20T00:00");
  // 일요일(2026-07-19)의 다음 주는 다음 월요일부터다.
  const next = weekRange(new Date(2026, 6, 19, 23, 59), 1);
  assertEquals(formatLocal(next.from), "2026-07-20T00:00");
  assertEquals(formatLocal(next.to), "2026-07-27T00:00");
});
