{
  "name": "@lophn/shell-renderer",
  "exports": "./desktop/entry.tsx",
  "imports": {
    "react": "npm:react@19.3.0",
    "react-dom": "npm:react-dom@19.3.0",
    "react-dom/client": "npm:react-dom@19.3.0/client",
    "@types/react": "npm:@types/react@19.3.0",
    "lucide-react": "npm:lucide-react@1.51.0",
    "esbuild": "npm:esbuild@0.28.2",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@0.11.1",
    "shiki/core": "npm:shiki@4.5.0/core",
    "shiki/engine/javascript": "npm:shiki@4.5.0/engine/javascript",
    "shiki/langs": "npm:shiki@4.5.0/langs",
    "@codemirror/commands": "npm:@codemirror/commands@6.11.1",
    "@codemirror/lang-json": "npm:@codemirror/lang-json@6.0.2",
    "@codemirror/lang-markdown": "npm:@codemirror/lang-markdown@6.5.2",
    "@codemirror/lang-yaml": "npm:@codemirror/lang-yaml@6.1.3",
    "@codemirror/language": "npm:@codemirror/language@6.12.4",
    "@codemirror/state": "npm:@codemirror/state@6.7.6",
    "@codemirror/view": "npm:@codemirror/view@6.43.13",
    "@xterm/xterm": "npm:@xterm/xterm@6.0.0",
    "@xterm/addon-fit": "npm:@xterm/addon-fit@0.11.0",
    "@xterm/addon-web-links": "npm:@xterm/addon-web-links@0.12.0",
    "@xterm/addon-webgl": "npm:@xterm/addon-webgl@0.19.0"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "ES2023",
      "DOM",
      "deno.ns"
    ]
  },
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-run --allow-env build.ts"
  }
}
