// blueprint에 선언한 command의 handler. 선언한 key와 등록한 handler가 같아야 준비가 끝난다.
import {
  command,
  CommandRejection,
  continueRead,
  decodeContinuation,
  type ReadQuery,
  readResult,
} from "@lophn/cap-schedule";
import { defaults, type Deps, fileFailure, withStore } from "./deps.ts";
import { addDays, isTimezone, parseDay } from "./time.ts";
import {
  aggregate,
  dataBasis,
  MAX_PERIOD_DAYS,
  parseCollection,
  type ReportQuery,
  rowKey,
  saveCollection,
} from "./usage.ts";

const FILE_NAME = /^[A-Za-z0-9][A-Za-z0-9._-]{0,79}\.json$/;
export const PAGE_LIMIT = 100;

function invalid(message: string): never {
  throw new CommandRejection("invalid_input", message);
}

function fileName(input: unknown): string {
  const name = (input as { file?: unknown } | null)?.file;
  if (typeof name !== "string" || !FILE_NAME.test(name)) {
    return invalid("the file name must be a plain JSON file name");
  }
  return name;
}

// 수집 파일 하나를 읽어 저장한다. 원천의 구간을 통째로 기록하므로 표본이 없는 구간도 "수집했다"로 남는다.
export function collectUsageHandler(deps: Deps = defaults) {
  return async (input: unknown) => {
    const name = fileName(input);
    let text: string;
    try {
      text = await deps.readText(`${deps.dir}/${name}`);
    } catch (error) {
      fileFailure(error, "collect_usage");
    }
    const collection = parseCollection(text);
    const saved = await withStore(
      deps,
      "collect_usage",
      (store) => saveCollection(store, collection, deps.now()),
    );
    return { ...saved, from: collection.from, to: collection.to };
  };
}

type ReportInput = {
  from: string;
  to: string;
  timezone: string;
  providers?: string[];
  order?: "asc" | "desc";
  limit?: number;
  continuation?: string;
};

// 하루별 provider별 사용량. 기간(from·to 달력 날짜, 양 끝 포함)과 시간대가 입력에 있고 결과에도 그대로 돌아온다.
// 결과의 coverage·freshness가 "수집했는데 0건"과 "미수집", 일부만 수집, 오래된 수집을 구별한다.
export function usageReportHandler(deps: Deps = defaults) {
  return async (input: unknown) => {
    const body = input as ReportInput;
    if (!isTimezone(body.timezone)) return invalid("the time zone is unknown");
    if (parseDay(body.from) === undefined || parseDay(body.to) === undefined) {
      return invalid("from and to must be calendar dates");
    }
    if (
      body.to < body.from || addDays(body.from, MAX_PERIOD_DAYS - 1) < body.to
    ) {
      return invalid(
        `the period must run forward and cover at most ${MAX_PERIOD_DAYS} days`,
      );
    }
    const query: ReportQuery = {
      from: body.from,
      to: body.to,
      timezone: body.timezone,
      providers: [...new Set(body.providers ?? [])].sort(),
      order: body.order ?? "asc",
    };
    const limit = body.limit ?? PAGE_LIMIT;
    return await withStore(deps, "usage_report", (store) => {
      const report = aggregate(store, query, Date.parse(deps.now()));
      const source = {
        coverage: report.coverage,
        freshness: report.freshness,
      };
      // 이어 읽기는 처음 조건·정렬·데이터 기준이 모두 같을 때만 받는다.
      const read: ReadQuery = {
        filter: {
          from: query.from,
          to: query.to,
          timezone: query.timezone,
          providers: query.providers,
        },
        order: [query.order],
        basis: dataBasis(store),
      };
      let after: string | null = null;
      if (body.continuation !== undefined) {
        let previous;
        try {
          previous = decodeContinuation(body.continuation);
        } catch {
          return invalid("the continuation is not valid");
        }
        try {
          continueRead(previous, read, [], source);
        } catch {
          throw new CommandRejection(
            "conflict",
            "the continuation no longer matches the filter, order or data it was made for",
          );
        }
        after = previous.cursor;
      }
      const rest = after === null
        ? report.rows
        : report.rows.filter((row) =>
          query.order === "asc" ? rowKey(row) > after : rowKey(row) < after
        );
      const rows = rest.slice(0, limit);
      const more = rest.length > rows.length;
      return {
        ...readResult(rows, {
          ...source,
          ...(more
            ? { continuation: { query: read, cursor: rowKey(rows.at(-1)!) } }
            : {}),
        }),
        period: report.period,
        collected_through: report.collected_through,
        providers: report.providers,
      };
    });
  };
}

export function registerCommands(deps: Deps = defaults): void {
  command("collect_usage", collectUsageHandler(deps));
  command("usage_report", usageReportHandler(deps));
}
