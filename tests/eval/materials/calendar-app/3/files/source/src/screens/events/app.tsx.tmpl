import { type FormEvent, useCallback, useEffect, useState } from "react";
import { Inbox } from "lucide-react";
import { Button } from "@lophn/ui/primitives";
import { Field, Input } from "@lophn/ui/input";
import { AppShell } from "@lophn/ui/layout";
import { ReadState } from "@lophn/ui/feedback";
import { t } from "../../wording/t.ts";
import {
  addEvent,
  type CalendarEvent,
  type EventRange,
  listEvents,
  removeEvent,
  startParts,
} from "./bridge.ts";
import styles from "./app.module.css";

// events 화면. 범위 단추, 일정 목록(줄마다 삭제), 새 일정 입력 하나다. 문구는 모두 en catalog의 key고, 읽기 결과의
// loading·empty·error는 @lophn/ui/feedback의 ReadState가 그린다.
export function App() {
  const [range, setRange] = useState<EventRange>("all");
  const [events, setEvents] = useState<CalendarEvent[]>([]);
  const [loading, setLoading] = useState(true);
  const [failed, setFailed] = useState(false);
  const [saveFailed, setSaveFailed] = useState(false);
  const [title, setTitle] = useState("");
  const [start, setStart] = useState("");

  const load = useCallback(async () => {
    setLoading(true);
    try {
      setEvents(await listEvents(range));
      setFailed(false);
    } catch {
      setFailed(true);
    } finally {
      setLoading(false);
    }
  }, [range]);

  useEffect(() => {
    void load();
  }, [load]);

  async function submit(event: FormEvent) {
    event.preventDefault();
    const parts = startParts(start);
    if (title.trim() === "" || parts === null) return;
    try {
      await addEvent(title, parts);
      setTitle("");
      setStart("");
      setSaveFailed(false);
      await load();
    } catch {
      setSaveFailed(true);
    }
  }

  async function remove(id: number) {
    try {
      await removeEvent(id);
    } finally {
      await load();
    }
  }

  const ranges: [EventRange, string][] = [
    ["this_week", t("events.button.this-week")],
    ["next_week", t("events.button.next-week")],
    ["all", t("events.button.all")],
  ];

  return (
    <AppShell title={t("events.title.screen")}>
      <div className={styles.ranges}>
        {ranges.map(([value, label]) => (
          <Button
            key={value}
            variant={value === range ? "primary" : "secondary"}
            onClick={() => setRange(value)}
          >
            {label}
          </Button>
        ))}
      </div>
      <form className={styles.form} onSubmit={submit}>
        <Field
          label={t("events.label.new-event")}
          error={saveFailed ? t("events.error.save-failed") : undefined}
        >
          <Input
            value={title}
            maxLength={200}
            onChange={(event) => setTitle(event.target.value)}
          />
        </Field>
        <Field label={t("events.label.start")}>
          <Input
            type="datetime-local"
            value={start}
            onChange={(event) => setStart(event.target.value)}
          />
        </Field>
        <div className={styles.actions}>
          <Button type="submit" variant="primary">
            {t("events.button.add")}
          </Button>
        </div>
      </form>
      <ReadState
        loading={loading}
        failed={failed ? t("events.label.events") : undefined}
        onRetry={() => void load()}
        isEmpty={events.length === 0}
        empty={{
          icon: Inbox,
          message: t("events.empty.none"),
          action: {
            label: t("events.button.reload"),
            onSelect: () => void load(),
          },
        }}
      >
        <p>{t("events.label.count", { count: events.length })}</p>
        <ul className={styles.list}>
          {events.map((item) => (
            <li key={item.id} className={styles.row}>
              <span>{item.start} {item.title}</span>
              <Button variant="danger" onClick={() => void remove(item.id)}>
                {t("events.button.remove")}
              </Button>
            </li>
          ))}
        </ul>
      </ReadState>
    </AppShell>
  );
}
