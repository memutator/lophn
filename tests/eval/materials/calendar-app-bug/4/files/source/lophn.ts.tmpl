import { type AppDeclaration, defineApp } from "@lophn/declaration";
import { en } from "./src/wording/en.ts";

// 이 선언이 정본이다. 코드를 바꾸기 전에 먼저 바꾼다.
// 사람에게 보이는 이름·설명은 en catalog 문구고, tool 이름·screen의 key는 문구와 별개의 식별자다.
// catalog 문구를 바꿔도 key는 같다(tests/wording_test.ts).
type Text = Readonly<Record<keyof typeof en, string>>;

const integer = (description: string, minimum: number, maximum?: number) => ({
  type: "integer" as const,
  description,
  minimum,
  ...(maximum === undefined ? {} : { maximum }),
});

export function makeDeclaration(text: Text = en): AppDeclaration {
  return defineApp({
    name: "캘린더",
    description: text["common.summary.app"],
    screens: [
      {
        key: "events",
        label: text["events.title.screen"],
        path: "/screens/events/index.html",
        sizes: ["full", "panel", "card"],
      },
    ],
    tools: [
      {
        name: "event.list",
        title: text["events.label.list-events"],
        description: text["events.summary.list-events"],
        effect: "read",
        inputSchema: {
          type: "object",
          properties: {
            range: {
              type: "string",
              description: text["events.summary.range"],
              enum: ["all", "this_week", "next_week"],
            },
          },
          additionalProperties: false,
        },
        domain: "calendar",
        public: false,
      },
      {
        name: "event.add",
        title: text["events.label.add-event"],
        description: text["events.summary.add-event"],
        effect: "write",
        inputSchema: {
          type: "object",
          properties: {
            title: {
              type: "string",
              description: text["events.summary.event-title"],
              minLength: 1,
              maxLength: 200,
            },
            start: {
              type: "object",
              description: text["events.summary.event-start"],
              properties: {
                year: integer(text["events.summary.start-year"], 2000, 2100),
                month: integer(text["events.summary.start-month"], 1, 12),
                day: integer(text["events.summary.start-day"], 1, 31),
                hour: integer(text["events.summary.start-hour"], 0, 23),
                minute: integer(text["events.summary.start-minute"], 0, 59),
              },
              required: ["year", "month", "day", "hour", "minute"],
              additionalProperties: false,
            },
          },
          required: ["title", "start"],
          additionalProperties: false,
        },
        domain: "calendar",
        public: false,
      },
      {
        name: "event.remove",
        title: text["events.label.remove-event"],
        description: text["events.summary.remove-event"],
        effect: "write",
        inputSchema: {
          type: "object",
          properties: {
            id: integer(text["events.summary.event-id"], 1),
          },
          required: ["id"],
          additionalProperties: false,
        },
        domain: "calendar",
        public: false,
      },
    ],
    permissions: [],
    app_connections: [
      {
        app: "app_0000000000000000000000ntfy",
        tools: ["notify.schedule"],
        reason: text["events.summary.notify-reason"],
      },
    ],
    // 정확한 version만 쓴다. deno.json의 import map과 같아야 한다(tests/declaration_test.ts).
    sdk_dependencies: [
      { name: "@lophn/declaration", version: "1.0.0" },
      { name: "@lophn/cap-problem", version: "1.0.0" },
      { name: "@lophn/cap-tool", version: "1.0.0" },
      { name: "@lophn/cap-store", version: "1.0.0" },
      { name: "@lophn/ui", version: "1.0.0" },
      { name: "@lophn/app-ui", version: "1.0.0" },
      { name: "@lophn/wording", version: "1.0.0" },
      { name: "@me/date-range", version: "1.0.0" },
    ],
  });
}

export default makeDeclaration();
