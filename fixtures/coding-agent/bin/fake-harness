#!/bin/sh
# fake harness TUI(coding-agent#T41). 제품 binary가 아니다. PATH에 있으면 테스트
# catalog의 command로 감지되고, catalog의 ExecutionSpec대로 prompt를 받는다.
set -eu
here=$(CDPATH= cd -- "$(dirname "$0")" && pwd)
root=$(CDPATH= cd -- "$here/../../.." && pwd)
exec deno run --quiet --allow-read "$root/tools/fake-coding-agent/tui.ts" "$@"
