// 이 파일은 lophn 템플릿이 만든 선언 test다. `lophn.ts`를 읽어 선언 자체와 선언·코드·화면·의존이
// 서로 맞는지 본다. 선언이 바뀌어도 이 파일은 고치지 않는다. 앱의 업무 규칙은 다른 test 파일에 둔다.
import assert from "node:assert/strict";
import { readFileSync, statSync } from "node:fs";
import { test } from "node:test";

import { registeredHandlers } from "@lophn/cap-tool";
import { validateDeclaration } from "@lophn/declaration";
import declaration from "../lophn.ts";
import { registerHandlers } from "../src/handlers.ts";

const root = new URL("../", import.meta.url);

test("declaration: the declaration is valid and already canonical", () => {
  const checked = validateDeclaration(declaration);
  assert.ok(checked.ok, checked.ok ? "" : checked.error.message);
  assert.deepStrictEqual(checked.value, declaration);
});

test("declaration: every declared operation and command has a registered handler and nothing else is registered", () => {
  registerHandlers();
  assert.deepStrictEqual(
    [...registeredHandlers()].sort(),
    [...declaration.operations, ...declaration.commands]
      .map((entry) => entry.name)
      .sort(),
  );
});

test("declaration: every screen has a source and its path is the screen entry", () => {
  for (const screen of declaration.screens) {
    assert.deepStrictEqual(screen.path, `/screens/${screen.key}/index.html`);
    for (const file of ["index.html", "main.tsx"]) {
      const info = statSync(
        new URL(`src/screens/${screen.key}/${file}`, root),
      );
      assert.ok(info.isFile(), `${screen.key}/${file} is missing`);
    }
  }
});

test("declaration: sdk_dependencies are exact and match package.json", () => {
  const config = JSON.parse(
    readFileSync(new URL("package.json", root), "utf8"),
  ) as { dependencies?: Record<string, string> };
  const pinned = new Set<string>();
  for (const [name, value] of Object.entries(config.dependencies ?? {})) {
    const match = /^file:\.lophn\/sdk\/(?:@me\/)?[^/]+\/([^/]+)$/.exec(value);
    if (match) pinned.add(`${name}@${match[1]}`);
  }
  const declared = declaration.sdk_dependencies.map((item) =>
    `${item.name}@${item.version}`
  );
  for (const item of declaration.sdk_dependencies) {
    assert.ok(
      /^\d+\.\d+\.\d+$/.test(item.version),
      `${item.name} is not an exact version`,
    );
  }
  assert.deepStrictEqual(declared.sort(), [...pinned].sort());
});
