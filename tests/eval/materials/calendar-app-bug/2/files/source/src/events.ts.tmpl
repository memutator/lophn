// 앱의 업무 규칙. DB 구조와 질의는 이 앱에 남고 SDK로 올리지 않는다(apps/sdk#R36).
import { type Migration, migrationOfSql, type Store } from "@lophn/cap-store";
import { formatLocal, weekRange } from "@me/date-range";

export type CalendarEvent = { id: number; title: string; start: string };
export type EventRange = "all" | "this_week" | "next_week";

export const SCHEMA_VERSION = 1;
export const LIST_LIMIT = 200;

// DB schema 단계다. SQL은 migrations/에 있고 공개한 단계는 고치지 않고 새 단계를 더한다.
export function migrations(): Migration[] {
  const step = migrationOfSql(
    0,
    SCHEMA_VERSION,
    Deno.readTextFileSync(new URL("../migrations/0-1.sql", import.meta.url)),
  );
  if (!step.ok) throw new Error(step.error.message);
  return [step.value];
}

// preview·test는 여기서 schema를 맞춘다. 운영(live)은 activation 때 data worker가 이미 맞췄다.
export async function ensureSchema(store: Store): Promise<void> {
  if (store.schema() < SCHEMA_VERSION) {
    await store.migrate(migrations(), { target: SCHEMA_VERSION });
  }
}

// 주 범위 규칙. 값은 이번 주에서 몇 주 뒤의 주인가다.
const RANGE_RULES: Record<string, { offset: number }> = {
  this_week: { offset: 0 },
};

// 목록 범위를 지역 시각 문자열 [from, to)로 바꾼다. 전체는 null이다. DB를 건드리지 않는다.
export function rangeBounds(
  range: EventRange,
  now: Date,
): { from: string; to: string } | null {
  if (range === "all") return null;
  const week = weekRange(now, RANGE_RULES[range].offset);
  return { from: formatLocal(week.from), to: formatLocal(week.to) };
}

export function addEvent(
  store: Store,
  title: string,
  start: string,
  createdAt: string,
): CalendarEvent {
  const row = store.db
    .prepare(
      "insert into event (title, start_at, created_at) values (?, ?, ?) returning id",
    )
    .get(title, start, createdAt) as { id: number };
  return { id: row.id, title, start };
}

export function listEvents(
  store: Store,
  bounds: { from: string; to: string } | null,
): CalendarEvent[] {
  const columns = "select id, title, start_at as start from event";
  const order = "order by start_at, id limit ?";
  return (bounds === null
    ? store.db.prepare(`${columns} ${order}`).all(LIST_LIMIT)
    : store.db
      .prepare(`${columns} where start_at >= ? and start_at < ? ${order}`)
      .all(bounds.from, bounds.to, LIST_LIMIT)) as CalendarEvent[];
}

// 지운 행이 있었으면 true. 없는 id는 오류가 아니다.
export function removeEvent(store: Store, id: number): boolean {
  return store.db.prepare("delete from event where id = ?").run(id).changes > 0;
}
