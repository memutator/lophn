import { newId, openStore } from "@lophn/cap-store";
import { handle } from "@lophn/cap-tool";

handle("list_items", () =>
  openStore()
    .db.prepare("select id, title from item order by id")
    .all(),
);

handle("add_item", (input) => {
  const title = String((input as { title?: unknown } | null)?.title ?? "");
  const id = newId("itm");
  openStore()
    .db.prepare("insert into item (id, title, created_at) values (?, ?, ?)")
    .run(id, title, new Date().toISOString());
  return { id };
});

// external은 컴퓨터에서만 도는 일이다. 폰은 이 handler를 부르지 않는다.
handle("send_report", () => ({ sent: true }));
