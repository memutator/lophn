// 화면이 앱 tool을 부르는 유일한 통로. lophn의 앱 preload가 `window.lophnApp`을 주고, 부를 수 있는 것은
// 이 view의 고정 blueprint에 선언한 tool 이름뿐이다. 화면은 앱 socket·credential을 알지 못한다.
export type Reminder = {
  id: number;
  title: string;
  at: number;
  at_local: string;
};

type LophnApp = {
  callTool(tool: string, input: Record<string, never>): Promise<unknown>;
};

function bridge(): LophnApp {
  const app = (globalThis as { lophnApp?: LophnApp }).lophnApp;
  if (!app) throw new Error("lophnApp is not available");
  return app;
}

export async function listReminders(): Promise<Reminder[]> {
  const result = await bridge().callTool("notify.list", {}) as {
    rows?: Reminder[];
  };
  return result.rows ?? [];
}
