# 진짜 model provider를 부르는 task(`deno task test:live`, 나중의 eval)가 읽는다.
# 이 file을 `.env`로 복사해 값을 채운다. `.env`는 git이 무시한다. 값을 commit하지 않는다.
# shell에 같은 이름이 있으면 shell 값이 이긴다.
# `deno task e2e`와 check는 이 file을 읽지 않는다. E2E는 core를 띄울 때 env를 비운다.

# provider API key. 비어 있으면 그 provider의 live file을 건너뛴다.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 1이면 live가 받은 응답을 tests/fixtures/provider/에 녹화한다(key와 계정 id는 지운다). 사람이 diff를 보고 commit한다.
# LOPHN_LIVE_RECORD=1

# 구독 OAuth(ChatGPT, SuperGrok)는 env로 넣지 않는다. refresh token이 갱신 때마다 바뀌어 env에 둔 값은 곧 낡는다.
# 사람이 한 번 로그인해 live 전용 data root에 저장하는 길을 쓴다.
