// 외부 캘린더 연동. 목적지와 secret 이름은 blueprint의 permissions와 같아야 한다(tests/calendar_test.ts).
// 요청은 cap-net(grant 범위의 정확한 host·port)과 cap-secret(인증은 전송부가 붙인다)만 쓴다.
// net 요청에는 body가 없어 만들 일정은 query로 보낸다. 값은 어디에도 남기지 않는다.
import type { NetClient } from "@lophn/cap-net";
import type { SecretClient } from "@lophn/cap-secret";
import { reportProblem } from "@lophn/cap-problem";
import { CommandRejection } from "@lophn/cap-schedule";

export const EXTERNAL = { host: "127.0.0.1", port: 38917 } as const;
export const TOKEN = "calendar.external-token";

export type ExternalEvent = { id: string; title: string; starts_at: string };

export type ExternalDeps = { net: NetClient; secret: SecretClient };

// cap-net과 cap-secret은 각자의 CapabilityError class를 가져 instanceof로 한 번에 알아보지 못한다.
type Capability = Error & { code: string; outcome?: "unknown" };
function capabilityError(error: unknown): error is Capability {
  return error instanceof Error && error.name === "CapabilityError";
}

// 외부 호출 하나. 요청이 상대에 닿았는지 알 수 없으면(전송 단절, 만들기 요청 뒤의 5xx) 효과를 모르는
// 실패로 던지고, 닿지 않았거나 거절된 것이 분명하면 효과 없는 거절이다. 이유 문장에는 응답 내용을
// 넣지 않는다.
async function call(
  deps: ExternalDeps,
  command: string,
  method: "GET" | "POST",
  path: string,
): Promise<unknown> {
  let status: number;
  let body: unknown;
  try {
    await deps.secret.use({ name: TOKEN, destination: EXTERNAL });
    ({ status, body } = await deps.net.fetch({ ...EXTERNAL, method, path }));
  } catch (error) {
    if (!capabilityError(error)) throw error;
    if (error.code === "forbidden") {
      throw new CommandRejection(
        "forbidden",
        "the external calendar access is not granted",
      );
    }
    reportProblem("external_calendar_unavailable", { command });
    if (error.outcome === "unknown") {
      throw new Error("the external calendar did not confirm the request");
    }
    throw new CommandRejection(
      "unavailable",
      "the external calendar is unavailable",
    );
  }
  if (status >= 200 && status < 300) return body;
  reportProblem("external_calendar_unavailable", { command });
  if (method === "POST" && status >= 500) {
    throw new Error("the external calendar did not confirm the request");
  }
  throw new CommandRejection(
    "unavailable",
    "the external calendar refused the request",
  );
}

export async function fetchExternalEvents(
  deps: ExternalDeps,
  command: string,
): Promise<ExternalEvent[]> {
  const body = await call(deps, command, "GET", "/events") as {
    events?: ExternalEvent[];
  } | null;
  return body?.events ?? [];
}

export async function createExternalEvent(
  deps: ExternalDeps,
  command: string,
  input: { title: string; starts_at: string },
): Promise<ExternalEvent> {
  const query = new URLSearchParams(input).toString();
  const body = await call(deps, command, "POST", `/events?${query}`) as {
    event?: ExternalEvent;
  } | null;
  // 2xx인데 본문이 없는 응답(고정 대역)은 만들어졌다는 사실만 있고 상대가 붙인 ID는 모른다.
  return body?.event ?? { id: "unconfirmed", ...input };
}
