  <TextView android:id="@+id/lw_text" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
    android:textSize="12sp" android:lineHeight="16sp" android:fontFamily="@font/pretendard_regular" android:textColor="@color/lophn_w_text" android:singleLine="true" android:ellipsize="none" />
  <TextView android:id="@+id/lw_trail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
    android:textSize="12sp" android:lineHeight="16sp" android:fontFamily="@font/pretendard_regular" android:textColor="@color/lophn_w_text_secondary" android:singleLine="true" />
</LinearLayout>
