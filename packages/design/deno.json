    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@0.11.1"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "ES2023",
      "DOM",
      "deno.ns"
    ],
    "types": [
      "./components/css-modules.d.ts"
    ]
  },
  "tasks": {
    "generate": "deno run --allow-read --allow-write --allow-run generate.ts",
    "check-generated": "deno run --allow-read --allow-run generate.ts --check"
  }
