// 이 파일은 lophn 템플릿이 만든 blueprint test다. blueprint를 읽어 선언 자체와 선언·코드·화면·의존이
// 서로 맞는지 본다. blueprint가 바뀌어도 이 파일은 고치지 않는다. 앱의 업무 규칙은 다른 test 파일에 둔다.
import { assert, assertEquals } from "@std/assert";
import { validateDeclaration } from "@lophn/declaration";
import { registeredTools } from "@lophn/cap-tool";
import declaration from "../lophn.ts";
import { registerTools } from "../src/tools.ts";

const root = new URL("../", import.meta.url);

Deno.test("declaration: the declaration is valid and already canonical", () => {
  const checked = validateDeclaration(declaration);
  assert(checked.ok, checked.ok ? "" : checked.error.message);
  assertEquals(checked.value, declaration);
});

Deno.test("declaration: every declared tool has a registered handler and nothing else is registered", () => {
  registerTools();
  assertEquals(
    [...registeredTools()].sort(),
    declaration.tools.map((tool) => tool.name).sort(),
  );
});

Deno.test("declaration: every screen has a source and its path is the screen entry", () => {
  for (const screen of declaration.screens) {
    assertEquals(screen.path, `/screens/${screen.key}/index.html`);
    for (const file of ["index.html", "main.tsx"]) {
      const info = Deno.statSync(
        new URL(`src/screens/${screen.key}/${file}`, root),
      );
      assert(info.isFile, `${screen.key}/${file} is missing`);
    }
  }
});

Deno.test("declaration: sdk_dependencies are exact and match the import map", () => {
  const config = JSON.parse(
    Deno.readTextFileSync(new URL("deno.json", root)),
  ) as { imports: Record<string, string> };
  const pinned = new Set<string>();
  for (const value of Object.values(config.imports)) {
    const match = /^lophn-sdk:(@[^/]+\/[^@]+)@([^/]+)\//.exec(value);
    if (match) pinned.add(`${match[1]}@${match[2]}`);
  }
  const declared = declaration.sdk_dependencies.map((item) =>
    `${item.name}@${item.version}`
  );
  for (const item of declaration.sdk_dependencies) {
    assert(
      /^\d+\.\d+\.\d+$/.test(item.version),
      `${item.name} is not an exact version`,
    );
  }
  assertEquals(declared.sort(), [...pinned].sort());
});
