// blueprint 선언이 이 앱이 하는 일과 맞는지 본다. 선언 자체의 검증과 command 등록 일치는 blueprint_test.ts가 본다.
import { assert, assertEquals } from "@std/assert";
import type { InputSchema } from "@lophn/blueprint";
import blueprint from "../blueprint.ts";
import {
  ADD_EVENT,
  ARCHIVE_APP,
  CALENDAR_APP,
  DELETE_ALL_EVENTS,
  EXPORT_DIR,
  IMPORT_DIR,
  SEND_TO_TODO,
} from "../src/places.ts";

function described(schema: InputSchema, path: string): string[] {
  const missing: string[] = [];
  for (const [key, child] of Object.entries(schema.properties ?? {})) {
    if (!child.description) missing.push(`${path}.${key}`);
  }
  return missing;
}

Deno.test("apps/blueprint#R2: 화면과 모든 command의 이름·설명과 입력 칸의 설명이 사람이 읽는 문장으로 있다", () => {
  for (const item of [...blueprint.screens, ...blueprint.commands]) {
    assert(item.label.trim() !== "", `${item.key} has no label`);
  }
  for (const item of blueprint.commands) {
    assert(
      item.description.trim().length > 20,
      `${item.key} has no description`,
    );
    assertEquals(
      item.input === null ? [] : described(item.input, item.key),
      [],
    );
  }
  assert(blueprint.description.trim() !== "");
});

Deno.test("apps/blueprint#R19: todos 화면은 전체와 패널 크기를 선언한다", () => {
  assertEquals(blueprint.screens.map((s) => [s.key, s.sizes]), [
    ["todos", ["full", "panel"]],
  ]);
});

Deno.test("apps/blueprint#R21: 되돌림을 지원하는 write는 add_todo·complete_todo이고 같은 앱의 다른 write command revert_todo가 되돌린다", () => {
  const by = new Map(blueprint.commands.map((c) => [c.key, c]));
  assertEquals(
    blueprint.commands.filter((c) => c.revert.supported).map((c) => c.key),
    ["add_todo", "complete_todo"],
  );
  for (const key of ["add_todo", "complete_todo"]) {
    assertEquals(by.get(key)?.effect, "write");
    assertEquals(by.get(key)?.revert, {
      supported: true,
      command: "revert_todo",
    });
  }
  const revert = by.get("revert_todo")!;
  assertEquals(revert.effect, "write");
  assertEquals(revert.revert, { supported: false });
  // 되돌림 command의 입력은 write가 돌려준 근거와 같은 세 칸이다.
  assertEquals(Object.keys(revert.input?.properties ?? {}).sort(), [
    "expected_revision",
    "invocation",
    "receipt",
  ]);
});

Deno.test("apps/blueprint#R5: 읽기·내보내기·가져오기·캘린더 호출의 효과는 가장 큰 효과로 선언한다", () => {
  const effects = Object.fromEntries(
    blueprint.commands.map((c) => [c.key, c.effect]),
  );
  assertEquals(effects["list_todos"], "read");
  assertEquals(effects["todo_context"], "read");
  // 가져온 파일을 업무 데이터에 저장하면 write, 파일을 바깥에 만들거나 다른 앱에 일정을 만들면 external이다.
  assertEquals(effects["import_markdown"], "write");
  assertEquals(effects["export_markdown"], "external");
  assertEquals(effects["add_to_calendar"], "external");
  assertEquals(effects["use_archive_calendar"], "external");
});

Deno.test("apps/permissions#R5: 파일 permission은 읽기와 쓰기를 서로 다른 폴더로 따로 선언한다", () => {
  assertEquals(
    blueprint.permissions.map((p) => [p.kind, p.scope]),
    [
      ["fs.read", { path: IMPORT_DIR, recursive: true }],
      ["fs.write", { path: EXPORT_DIR, recursive: true }],
    ],
  );
  // 이름 prefix만 같은 폴더가 아니어야 한다.
  assert(
    !IMPORT_DIR.startsWith(EXPORT_DIR) && !EXPORT_DIR.startsWith(IMPORT_DIR),
  );
});

Deno.test("apps/connections#R1: 캘린더 앱의 add_event와 보관 캘린더 앱의 delete_all_events·send_to_todo만 목적과 함께 선언한다", () => {
  assertEquals(
    blueprint.app_connections.map((entry) => [entry.app, entry.commands]),
    [
      [CALENDAR_APP, [ADD_EVENT]],
      [ARCHIVE_APP, [DELETE_ALL_EVENTS, SEND_TO_TODO]],
    ],
  );
  for (const entry of blueprint.app_connections) {
    assert(entry.reason.trim() !== "");
  }
});
