// 화면이 앱 command를 부르는 유일한 통로. lophn의 앱 preload가 `window.lophnApp`을 주고, command는
// 이 view의 고정 blueprint에 선언한 key뿐이다. 화면은 앱 socket·credential을 알지 못한다.
export type BoardRow = {
  screen: string;
  broken: boolean;
};

type Input = { [key: string]: string | number | boolean };

type LophnApp = {
  call(command: string, input: Input | null): Promise<unknown>;
};

function bridge(): LophnApp {
  const app = (globalThis as { lophnApp?: LophnApp }).lophnApp;
  if (!app) throw new Error("lophnApp is not available");
  return app;
}

// 화면이 받는 값은 앱 응답 전체 `{result: {result, revert?}, invocation?, mode}`다. 업무 값은 안쪽 result다.
async function call<T>(command: string, input: Input | null): Promise<T> {
  const body = await bridge().call(command, input) as {
    result?: { result?: T };
  };
  return body.result?.result as T;
}

export async function listBroken(): Promise<BoardRow[]> {
  const result = await call<{ rows?: BoardRow[] }>("list_broken", null);
  return result?.rows ?? [];
}

export async function runBroken(kind: string): Promise<void> {
  await call("run_broken", { kind });
}

export async function panelContext(): Promise<void> {
  const view = new URLSearchParams(globalThis.location?.search ?? "").get(
    "view_session",
  );
  if (view === null) return;
  await call("panel_context", { screen: "panel", view_session: view });
}

// view의 event handler가 부르는 write다(apps#T26 완료 4번). 깨진 상태는 이 자에서 내보낸다.
export async function markKind(kind: string): Promise<void> {
  await call("mark_kind", { kind });
}

// 화면이 fixture 설정을 읽는다(apps#T26 완료 1번). read_settings의 결과는 problems 목록이다.
export async function readSettings(): Promise<{ problems: string[] }> {
  const result = await call<{ problems?: string[] }>("read_settings", null);
  return { problems: result?.problems ?? [] };
}
