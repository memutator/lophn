// 선언한 problem code마다 실제 command의 실패 경로로 보고가 나가는지 본다. SDK 호출만 따로 부르는 test는
// 이 검사를 대신하지 못한다. 선언한 code를 더하면 그 code의 실패 경로 test를 여기에 하나 더한다.
import { assertEquals, assertRejects } from "@std/assert";
import { installProblemReporter } from "@lophn/cap-problem";
import { CommandRejection } from "@lophn/cap-schedule";
import {
  addEventHandler,
  createExternalEventHandler,
  deleteAllEventsHandler,
  listEventsHandler,
  revertEventHandler,
  syncEventsHandler,
} from "../src/commands.ts";
import { createFakeExternal } from "../fake-external/server.ts";
import { cutNet, depsFor, withData } from "./support.ts";

// 보고 통로는 진입점이 설치한다. test는 보고를 모으는 reporter를 같은 자리에 설치한다.
const reports: { code: string; details: unknown }[] = [];
installProblemReporter((code, details) => {
  reports.push({ code, details });
  return {
    report_id: "rpt_test",
    completion: Promise.resolve({
      status: "failed",
      reason: { code: "unavailable", message: "recorder" },
    }),
  };
});

// 열 수 없는 저장소. 원문 오류가 보고나 거절 문장에 새지 않는지도 본다.
const broken = {
  ...depsFor("unused", createFakeExternal()).deps,
  openStore: () => {
    throw new Error("disk is on fire: /secret/path");
  },
};

const EVENT = { title: "x", starts_at: "2026-02-05T09:00:00Z" };

Deno.test("failure_path:store_unavailable list_events reports the declared code when the store cannot be opened", async () => {
  reports.length = 0;
  const error = await assertRejects(
    async () => await listEventsHandler(broken)(),
    CommandRejection,
  );
  assertEquals(error.code, "unavailable");
  assertEquals(error.message.includes("/secret/path"), false);
  assertEquals(reports, [{
    code: "store_unavailable",
    details: { command: "list_events" },
  }]);
});

Deno.test("failure_path:store_unavailable add_event reports the declared code when the store cannot be opened", async () => {
  reports.length = 0;
  await assertRejects(
    async () => await addEventHandler(broken)(EVENT),
    CommandRejection,
  );
  assertEquals(reports, [{
    code: "store_unavailable",
    details: { command: "add_event" },
  }]);
});

Deno.test("failure_path:store_unavailable revert_event and delete_all_events report the declared code when the store cannot be opened", async () => {
  reports.length = 0;
  await assertRejects(
    async () => await revertEventHandler(broken)({
      invocation: "inv_calendar", receipt: "change:1", expected_revision: "1",
    }),
    CommandRejection,
  );
  await assertRejects(
    async () => await deleteAllEventsHandler(broken)(),
    CommandRejection,
  );
  assertEquals(reports.map((report) => report.details), [
    { command: "revert_event" },
    { command: "delete_all_events" },
  ]);
});

Deno.test("failure_path:store_unavailable sync_events reports the declared code when the fetched events cannot be saved", async () => {
  reports.length = 0;
  const fake = createFakeExternal([
    { id: "ext-1", title: "A", starts_at: "2026-02-05T09:00:00Z" },
  ]);
  await assertRejects(
    async () =>
      await syncEventsHandler({
        ...depsFor("unused", fake).deps,
        openStore: broken.openStore,
      })(),
    CommandRejection,
  );
  assertEquals(reports, [{
    code: "store_unavailable",
    details: { command: "sync_events" },
  }]);
});

Deno.test("failure_path:external_calendar_unavailable sync_events reports the declared code and saves nothing when the external calendar fails", async () => {
  reports.length = 0;
  await withData(async (dataPath) => {
    const fake = createFakeExternal([
      { id: "ext-1", title: "A", starts_at: "2026-02-05T09:00:00Z" },
    ]);
    const { deps } = depsFor(dataPath, fake);
    fake.failNext(500);
    const error = await assertRejects(
      async () => await syncEventsHandler(deps)(),
      CommandRejection,
    );
    // 가져오기만 하는 요청의 실패는 효과가 없는 거절이다.
    assertEquals(error.code, "unavailable");
    assertEquals(reports, [{
      code: "external_calendar_unavailable",
      details: { command: "sync_events" },
    }]);
    assertEquals((await listEventsHandler(deps)()).rows, []);
  });
});

Deno.test("failure_path:external_calendar_unavailable create_external_event rejects a refused request but leaves the effect unknown when the external calendar fails after the request", async () => {
  reports.length = 0;
  await withData(async (dataPath) => {
    const fake = createFakeExternal();
    const { deps } = depsFor(dataPath, fake);
    // 상대가 요청을 거절했다(4xx): 만들어지지 않았다는 분명한 거절이다.
    fake.failNext(400);
    const refused = await assertRejects(
      async () => await createExternalEventHandler(deps)(EVENT),
      CommandRejection,
    );
    assertEquals(refused.code, "unavailable");
    // 만들기 요청 뒤의 5xx는 상대가 만들었는지 알 수 없다. 거절(효과 없음)이 아니라 결과 모름이다.
    fake.failNext(502);
    const unknown = await assertRejects(
      async () => await createExternalEventHandler(deps)(EVENT),
      Error,
    );
    assertEquals(unknown instanceof CommandRejection, false);
    assertEquals(unknown.message.includes("did not confirm"), true);
    assertEquals(reports.map((report) => report.code), [
      "external_calendar_unavailable",
      "external_calendar_unavailable",
    ]);
  });
});

Deno.test("failure_path:external_calendar_unavailable a cut connection rejects a fetch but leaves a create request with an unknown effect", async () => {
  reports.length = 0;
  await withData(async (dataPath) => {
    const { deps } = depsFor(dataPath, createFakeExternal());
    const cut = { ...deps, net: cutNet() };
    // 읽기 요청은 아무것도 바꾸지 않았으니 효과 없는 거절이다.
    const fetched = await assertRejects(
      async () => await syncEventsHandler(cut)(),
      CommandRejection,
    );
    assertEquals(fetched.code, "unavailable");
    // 만들기 요청은 상대에 닿았는지 모른다. 거절로 꾸미지 않고 결과 모름으로 둔다.
    const created = await assertRejects(
      async () => await createExternalEventHandler(cut)(EVENT),
      Error,
    );
    assertEquals(created instanceof CommandRejection, false);
    assertEquals(created.message.includes("did not confirm"), true);
    assertEquals(reports.length, 2);
  });
});
