// 화면 문구 검사(apps/sdk#R41). 고정 문구의 직접 삽입, 빠진 en key, placeholder 불일치가 여기서 실패한다.
// 화면 언어는 en 하나이고 문구는 message key로만 쓴다. tool 이름·screen key는 문구와 별개의 식별자다.
import assert from "node:assert/strict";
import { readdirSync, readFileSync } from "node:fs";
import { test } from "node:test";

import { checkSource, errorsOf } from "@lophn/wording/check";
import { render } from "@lophn/wording/generate";
import declaration, { makeDeclaration } from "../lophn.ts";
import { en } from "../src/wording/en.ts";
import { t } from "../src/wording/t.ts";

const root = new URL("../", import.meta.url);
// key의 첫 구간은 이 앱의 screen key와 common이다.
const screens = [...declaration.screens.map((screen) => screen.key), "common"];

function screenSources(): { path: string; text: string }[] {
  const found: { path: string; text: string }[] = [];
  function visit(directory: URL, prefix: string) {
    for (const entry of readdirSync(directory, { withFileTypes: true })) {
      const path = `${prefix}${entry.name}`;
      if (entry.isDirectory()) {
        visit(new URL(`${entry.name}/`, directory), `${path}/`);
      } else if (path.endsWith(".tsx")) {
        found.push({ path, text: readFileSync(new URL(path, root), "utf8") });
      }
    }
  }
  visit(new URL("src/screens/", root), "src/screens/");
  return found;
}

test("wording: screen code has no fixed text and uses only keys of the en catalog", () => {
  const sources = screenSources();
  for (const source of sources) {
    assert.deepStrictEqual(
      errorsOf(checkSource(source.path, source.text, en, { screens })),
      [],
      source.path,
    );
  }
});

test("wording: the en catalog has valid keys, ICU sentences and no empty value", () => {
  assert.deepStrictEqual(
    errorsOf(
      checkSource("src/wording/en.ts", JSON.stringify(en, null, 2), en, {
        screens,
      }),
    ),
    [],
  );
});

test("wording: a fixed text in a screen and a key missing from the catalog fail the check", () => {
  const literal = checkSource(
    "a.tsx",
    "export const A = () => <p>Saved</p>;",
    en,
    { screens },
  );
  assert.deepStrictEqual(errorsOf(literal).map((finding) => finding.rule), [
    "literal-text",
  ]);
  const missing = checkSource(
    "b.tsx",
    'const x = t("common.title.missing");',
    en,
    { screens },
  );
  assert.deepStrictEqual(errorsOf(missing).map((finding) => finding.rule), [
    "unknown-key",
  ]);
  const counted = {
    ...en,
    "common.label.count": "{count, plural, one {# item} other {# items}}",
  };
  const mismatch = checkSource(
    "c.tsx",
    'const x = t("common.label.count", { total: 1 });',
    counted,
    { screens },
  );
  assert.deepStrictEqual(
    errorsOf(mismatch).map((finding) => finding.rule),
    ["placeholder-mismatch"],
  );
  const noEnglish = { ...en, "common.summary.app": "" };
  assert.deepStrictEqual(
    errorsOf(
      checkSource("en.ts", JSON.stringify(noEnglish), noEnglish, { screens }),
    )
      .map((finding) => finding.rule),
    ["empty-message"],
  );
});

test("wording: placeholders.ts is generated from the catalog and t formats with ICU", () => {
  const current = readFileSync(
    new URL("src/wording/placeholders.ts", root),
    "utf8",
  );
  assert.deepStrictEqual(current, render(en, "npm run wording --"));
  assert.deepStrictEqual(t("common.summary.app"), en["common.summary.app"]);
});

test("wording: changing catalog text never changes a tool name or screen key", () => {
  const rewritten = Object.fromEntries(
    Object.entries(en).map(([key, value]) => [key, `${value} (changed)`]),
  ) as unknown as Record<keyof typeof en, string>;
  const changed = makeDeclaration(rewritten);
  assert.deepStrictEqual(
    changed.tools.map((tool) => tool.name),
    declaration.tools.map((tool) => tool.name),
  );
  assert.deepStrictEqual(
    changed.screens.map((s) => s.key),
    declaration.screens.map((s) => s.key),
  );
  // 문구는 따라 바뀌지만 이름은 같다.
  assert.deepStrictEqual(
    changed.description !== declaration.description,
    true,
  );
});
