-- 되돌림 자료는 변경 revision과 invocation에 묶고 이미 되돌린 receipt는 다시 쓰지 않는다.
create table change (
  id integer primary key,
  event integer,
  invocation text,
  reverted integer not null default 0 check (reverted in (0, 1))
);
create trigger event_insert_change after insert on event begin
  insert into change (event) values (new.id);
end;
create trigger event_update_change after update on event begin
  insert into change (event) values (new.id);
end;
create trigger event_delete_change after delete on event begin
  insert into change (event) values (old.id);
end;
