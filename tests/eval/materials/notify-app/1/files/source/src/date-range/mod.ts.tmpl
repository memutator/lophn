// 지역 시각의 날짜 칸 검사와 주 범위 도우미. import가 없다: 설치되는 사본에는 이 폴더의 file만 든다.
export type DateParts = {
  year: number;
  month: number;
  day: number;
  hour: number;
  minute: number;
};

// 실제 있는 지역 시각이면 Date, 아니면 null(2월 30일, 24시 등). Date가 넘치는 칸을 이월하므로 getter 값이
// 입력과 같은지 본다.
export function toDate(parts: DateParts): Date | null {
  const date = new Date(
    parts.year,
    parts.month - 1,
    parts.day,
    parts.hour,
    parts.minute,
  );
  const same = date.getFullYear() === parts.year &&
    date.getMonth() === parts.month - 1 &&
    date.getDate() === parts.day &&
    date.getHours() === parts.hour &&
    date.getMinutes() === parts.minute;
  return same ? date : null;
}

const pad = (value: number, width = 2) => String(value).padStart(width, "0");

// 지역 시각 "YYYY-MM-DDTHH:mm".
export function formatLocal(date: Date): string {
  return `${pad(date.getFullYear(), 4)}-${pad(date.getMonth() + 1)}-${
    pad(date.getDate())
  }T${pad(date.getHours())}:${pad(date.getMinutes())}`;
}

// now가 든 주(월요일 00:00 지역 시각에서 시작)에서 offsetWeeks주 뒤의 주. from 포함, to 미포함(다음 월요일 00:00).
// 밀리초를 더하지 않고 날짜 칸을 바꿔 만든다. 서머타임 때문에 하루가 24시간이 아닐 수 있다.
export function weekRange(
  now: Date,
  offsetWeeks: number,
): { from: Date; to: Date } {
  const sinceMonday = (now.getDay() + 6) % 7;
  const monday = now.getDate() - sinceMonday + offsetWeeks * 7;
  return {
    from: new Date(now.getFullYear(), now.getMonth(), monday),
    to: new Date(now.getFullYear(), now.getMonth(), monday + 7),
  };
}
