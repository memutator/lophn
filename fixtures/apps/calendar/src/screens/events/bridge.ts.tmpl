// 화면이 앱 command를 부르는 유일한 통로. lophn의 앱 preload가 `window.lophnApp`을 주고, command는
// 이 view의 고정 blueprint에 선언한 key뿐이다. 화면은 앱 socket·credential을 알지 못한다.
export type CalendarEvent = {
  id: number;
  title: string;
  starts_at: string;
  source: "local" | "external";
};

type LophnApp = {
  call(
    command: string,
    input: Record<string, never> | { title: string; starts_at: string },
  ): Promise<unknown>;
};

function bridge(): LophnApp {
  const app = (globalThis as { lophnApp?: LophnApp }).lophnApp;
  if (!app) throw new Error("lophnApp is not available");
  return app;
}

export async function listEvents(): Promise<CalendarEvent[]> {
  const result = await bridge().call("list_events", {}) as {
    rows?: CalendarEvent[];
  };
  return result.rows ?? [];
}

export async function addEvent(title: string, startsAt: string): Promise<void> {
  await bridge().call("add_event", { title, starts_at: startsAt });
}

export async function syncEvents(): Promise<void> {
  await bridge().call("sync_events", {});
}
