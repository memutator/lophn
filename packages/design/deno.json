{
  "name": "@lophn/design",
  "exports": {
    ".": "./mod.ts",
    "./components": "./components/mod.ts",
    "./reading": "./reading/mod.ts",
    "./base.css": "./base.css",
    "./tokens.css": "./generated/tokens.css"
  },
  "imports": {
    "postcss": "npm:postcss@8.5.28",
    "postcss-value-parser": "npm:postcss-value-parser@4.2.0",
    "react": "npm:react@19.3.0",
    "react-dom": "npm:react-dom@19.3.0",
    "react-dom/client": "npm:react-dom@19.3.0/client",
    "@types/react": "npm:@types/react@19.3.0",
    "@radix-ui/react-checkbox": "npm:@radix-ui/react-checkbox@1.3.11",
    "@radix-ui/react-select": "npm:@radix-ui/react-select@2.3.7",
    "@radix-ui/react-switch": "npm:@radix-ui/react-switch@1.3.7",
    "@radix-ui/react-tabs": "npm:@radix-ui/react-tabs@1.1.21",
    "lucide-react": "npm:lucide-react@1.51.0",
    "@lezer/markdown": "npm:@lezer/markdown@1.7.2",
    "happy-dom": "npm:happy-dom@20.14.5",
    "esbuild": "npm:esbuild@0.28.2",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@0.11.1"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "ES2023",
      "DOM",
      "deno.ns"
    ],
    "types": [
      "./components/css-modules.d.ts"
    ]
  },
  "tasks": {
    "generate": "deno run --allow-read --allow-write --allow-run generate.ts",
    "check-generated": "deno run --allow-read --allow-run generate.ts --check"
  }
}
