// 선언한 problem code마다 실제 command의 실패 경로로 보고가 나가는지 본다. SDK 호출만 따로 부르는 test는
// 이 검사를 대신하지 못한다. 선언한 code를 더하면 그 code의 실패 경로 test를 여기에 하나 더한다.
import { assertEquals, assertRejects } from "@std/assert";
import { installProblemReporter } from "@lophn/cap-problem";
import { CommandRejection } from "@lophn/cap-schedule";
import { collectUsageHandler, usageReportHandler } from "../src/commands.ts";
import { defaults } from "../src/deps.ts";
import { depsAt, NOW, withPlace } from "./support.ts";

// 보고 통로는 진입점이 설치한다. test는 보고를 모으는 reporter를 같은 자리에 설치한다.
const reports: { code: string; details: unknown }[] = [];
installProblemReporter((code, details) => {
  reports.push({ code, details });
  return {
    report_id: "rpt_test",
    completion: Promise.resolve({
      status: "failed",
      reason: { code: "unavailable", message: "recorder" },
    }),
  };
});

// 열 수 없는 저장소. 원문 오류가 보고나 거절 문장에 새지 않는지도 본다.
const brokenStore = {
  ...defaults,
  openStore: () => {
    throw new Error("disk is on fire: /secret/path");
  },
  now: () => NOW,
};

Deno.test("failure_path:store_unavailable usage_report reports the declared code when the store cannot be opened", async () => {
  reports.length = 0;
  const error = await assertRejects(
    async () =>
      await usageReportHandler(brokenStore)({
        from: "2026-10-01",
        to: "2026-10-02",
        timezone: "UTC",
      }),
    CommandRejection,
  );
  assertEquals(error.code, "unavailable");
  assertEquals(error.message.includes("/secret/path"), false);
  assertEquals(reports, [{
    code: "store_unavailable",
    details: { command: "usage_report" },
  }]);
});

Deno.test("failure_path:store_unavailable collect_usage reports the declared code when the store cannot be opened", async () => {
  await withPlace(async (place) => {
    reports.length = 0;
    await Deno.writeTextFile(
      `${place.imports}/usage.json`,
      JSON.stringify({
        from: "2026-10-01T00:00:00Z",
        to: "2026-10-02T00:00:00Z",
        samples: [],
      }),
    );
    await assertRejects(
      async () =>
        await collectUsageHandler(
          depsAt(place, { openStore: brokenStore.openStore }),
        )({ file: "usage.json" }),
      CommandRejection,
    );
    assertEquals(reports, [{
      code: "store_unavailable",
      details: { command: "collect_usage" },
    }]);
  });
});

Deno.test("failure_path:file_unavailable collect_usage reports the declared code when the file cannot be read", async () => {
  await withPlace(async (place) => {
    reports.length = 0;
    const error = await assertRejects(
      async () =>
        await collectUsageHandler(
          depsAt(place, {
            readText: () => Promise.reject(new Error("io error: /secret/path")),
          }),
        )({ file: "usage.json" }),
      CommandRejection,
    );
    assertEquals(error.code, "unavailable");
    assertEquals(error.message.includes("/secret/path"), false);
    assertEquals(reports, [{
      code: "file_unavailable",
      details: { command: "collect_usage" },
    }]);
  });
});
