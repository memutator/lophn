// 화면 build. 개발 때 `npm run build`로 돌린다. src/screens/<key>/의 화면을 고정한 UI Package와 함께
// 묶어 dist/screens/<key>/에 index.html·main.js·main.js.map·main.css와 글꼴을 만든다. 운영은 build나 의존 다운로드를
// 하지 않고 release 준비가 bundle에 담은 이 결과만 읽는다(apps/sdk#R10, R34).
import { existsSync } from "node:fs";
import { copyFile, mkdir, readdir, rm } from "node:fs/promises";
import { join } from "node:path";

import * as esbuild from "esbuild";

const root = join(import.meta.dirname, "..");

// 화면은 src/screens/<key>/main.tsx다. 선언의 screens와 같은 key를 쓴다. 폰 화면(phone.tsx가 있는 dir)은
// 건너뛴다: 폰 화면의 build는 release 준비가 한다.
const screens: string[] = [];
for (const entry of await readdir(join(root, "src/screens"), {
  withFileTypes: true,
})) {
  if (
    entry.isDirectory() &&
    !existsSync(join(root, "src/screens", entry.name, "phone.tsx"))
  ) {
    screens.push(entry.name);
  }
}

for (const screen of screens.sort()) {
  const out = join(root, "dist/screens", screen);
  await rm(out, { recursive: true, force: true });
  await mkdir(out, { recursive: true });
  await esbuild.build({
    absWorkingDir: root,
    entryPoints: [join(root, "src/screens", screen, "main.tsx")],
    outdir: out,
    bundle: true,
    format: "esm",
    jsx: "automatic",
    minify: true,
    sourcemap: "external",
    sourcesContent: true,
    // 글꼴은 파일로 내보내고 svg는 화면 코드가 문자열로 읽는다. `.module.css`는 esbuild가 local-css로 안다.
    loader: { ".woff2": "file", ".woff": "file", ".svg": "text" },
    assetNames: "[name]",
    define: { "process.env.NODE_ENV": '"production"' },
    logLevel: "error",
  });
  await copyFile(
    join(root, "src/screens", screen, "index.html"),
    join(out, "index.html"),
  );
}

await esbuild.stop();
