{
  "expo": {
    "name": "lophn",
    "slug": "lophn",
    "scheme": "lophn",
    "version": "0.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "android": {
      "package": "dev.lophn.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "allowBackup": false,
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "extraProguardRules": "# react-native-sandbox (the guest runtime) calls Kotlin methods from JNI; R8 must not strip or rename them.\n-keep class io.callstack.rnsandbox.** { *; }"
          }
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "lophn uses the camera to scan the pairing QR code shown on your computer and to take photos you add to a message.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "lophn reads the photos you choose to add to a message.",
          "cameraPermission": "lophn uses the camera to scan the pairing QR code shown on your computer and to take photos you add to a message.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "lophn shares your location with an app on your computer when you allowed that app to use it."
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "node_modules/pretendard/dist/public/static/alternative/Pretendard-Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "node_modules/pretendard/dist/public/static/alternative/Pretendard-Medium.ttf",
                    "weight": 500
                  },
                  {
                    "path": "node_modules/pretendard/dist/public/static/alternative/Pretendard-SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "JetBrainsMono",
                "fontDefinitions": [
                  {
                    "path": "node_modules/@expo-google-fonts/jetbrains-mono/400Regular/JetBrainsMono_400Regular.ttf",
                    "weight": 400
                  },
                  {
                    "path": "node_modules/@expo-google-fonts/jetbrains-mono/500Medium/JetBrainsMono_500Medium.ttf",
                    "weight": 500
                  }
                ]
              }
            ]
          }
        }
      ],
      "./plugins/with-guest-runtime.js"
    ],
    "experiments": {
      "tsconfigPaths": false
    }
  }
}
