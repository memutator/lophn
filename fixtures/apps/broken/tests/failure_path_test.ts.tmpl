// 선언한 problem code마다 실제 command의 실패 경로로 보고가 나가는지 본다. SDK 호출만 따로 부르는 test는
// 이 검사를 대신하지 못한다. 선언한 code를 더하면 그 code의 실패 경로 test를 여기에 하나 더한다.
import { assertEquals, assertRejects } from "@std/assert";
import { installProblemReporter } from "@lophn/cap-problem";
import { CommandRejection } from "@lophn/cap-schedule";
import {
  chatterThenFailHandler,
  floodReportsHandler,
  listBrokenHandler,
  readSettingsHandler,
  reportWrongCodeHandler,
  runBrokenHandler,
} from "../src/commands.ts";
import { defaults } from "../src/deps.ts";
import { NOW } from "./support.ts";

// 보고 통로는 진입점이 설치한다. test는 보고를 모으는 reporter를 같은 자리에 설치한다.
const reports: { code: string; details: unknown }[] = [];
installProblemReporter((code, details) => {
  reports.push({ code, details });
  return {
    report_id: "rpt_test",
    completion: Promise.resolve({
      status: "failed",
      reason: { code: "unavailable", message: "recorder" },
    }),
  };
});

// board A(깨짐)에서 돈다. board C(약화)는 보고를 지우므로 이 test는 A에서만 같다.
Deno.test("failure_path:fixture_broken run_broken reports the declared code when the failure runs", async () => {
  reports.length = 0;
  const handler = runBrokenHandler({ ...defaults, now: () => NOW });
  const result = await handler({ kind: "dependency_throw" });
  assertEquals(result.rows.length, 0);
  assertEquals(reports, [{
    code: "fixture_broken",
    details: { command: "run_broken", kind: "dependency_throw" },
  }]);
});

Deno.test("failure_path:fixture_broken run_broken type_error leaves the handler with an unhandled error", async () => {
  reports.length = 0;
  const handler = runBrokenHandler({ ...defaults, now: () => NOW });
  // handler 안의 TypeError는 command handler 밖으로 던져진다(process exception).
  await assertRejects(
    async () => await handler({ kind: "type_error" }),
    TypeError,
  );
  assertEquals(reports[0], {
    code: "fixture_broken",
    details: { command: "run_broken", kind: "type_error" },
  });
});

Deno.test("failure_path:fixture_broken flood_reports sends more reports than the core window allows", () => {
  reports.length = 0;
  const handler = floodReportsHandler({ ...defaults, now: () => NOW });
  const result = handler();
  assertEquals(result.sent, 25);
  assertEquals(reports.length, 25);
});

Deno.test("failure_path:fixture_broken chatter_then_fail fails after writing log lines", async () => {
  reports.length = 0;
  const lines: string[] = [];
  const handler = chatterThenFailHandler({
    ...defaults,
    now: () => NOW,
    log: (line) => lines.push(line),
  });
  // 응답 뒤 비동기로도 실패한다(둘째 절반). reject가 test를 끝내지 않게 이 test에서 받는다.
  const late = new Promise<unknown>((resolve) => {
    globalThis.addEventListener("unhandledrejection", (event) => {
      event.preventDefault();
      resolve((event as PromiseRejectionEvent).reason);
    }, { once: true });
  });
  await assertRejects(
    async () => await handler(),
    CommandRejection,
  );
  assertEquals(lines.length > 30, true);
  assertEquals(
    (await late as Error).message,
    "late failure after the chatter_then_fail response",
  );
});

Deno.test("failure_path:fixture_misconfigured read_settings reports the declared code when a fixture setting is wrong", () => {
  reports.length = 0;
  const handler = readSettingsHandler({ ...defaults, now: () => NOW });
  const result = handler();
  // board A의 설정 레코드다. label_max가 모자라 fixture_misconfigured로 보고한다(fixer user).
  assertEquals(result.problems, ["label_max"]);
  assertEquals(reports, [{
    code: "fixture_misconfigured",
    details: { command: "read_settings", settings: "label_max" },
  }]);
});

Deno.test("failure_path:fixture_broken list_broken answers a wrong aggregate as a normal response", () => {
  reports.length = 0;
  const handler = listBrokenHandler({ ...defaults, now: () => NOW });
  const result = handler();
  // board A의 틀린 집계다. coverage가 partial로 떨어진다.
  assertEquals(result.coverage, "partial");
  assertEquals(reports, []);
});

Deno.test("report_wrong_code sends an undeclared code; fixture_misconfigured comes only from read_settings", () => {
  reports.length = 0;
  const handler = reportWrongCodeHandler({ ...defaults, now: () => NOW });
  const result = handler({ kind: "anything" });
  assertEquals(result.sent, true);
  // 미선언 code다(apps#T26 완료 5번). core는 이 보고를 _invalid_report group으로 모은다.
  assertEquals(reports, [
    { code: "_invalid_report", details: { command: "report_wrong_code" } },
  ]);
});
