{
  "name": "lophn",
  "version": "0.10.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "packages/sdk/*",
    "packages/shell/main",
    "packages/shell/renderer",
    "tools/wireframes",
    "packages/design/i18n"
  ],
  "scripts": {
    "check": "node tools/check.ts",
    "check:full": "node tools/check.ts --full",
    "eval": "node --env-file=.env tests/eval/run.ts",
    "eval:experiment": "node --env-file=.env tests/eval/run.ts experiment",
    "eval:gate": "node tests/eval/run.ts gate",
    "eval:judge": "node tests/eval/judge/main.ts",
    "eval:scorecard": "node tests/eval/scorecard/main.ts",
    "e2e": "ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron --test --test-concurrency=1 tests/e2e/*_test.ts",
    "e2e:deps": "ELECTRON_RUN_AS_NODE=1 node_modules/electron/dist/electron tests/support/app/prepare-deps.ts",
    "test:live": "node --env-file=.env tests/live/run.ts",
    "test:live:login": "node tests/live/login.ts",
    "dev": "node tools/dev.ts dev",
    "dev:core": "node tools/dev.ts dev:core",
    "dev:mock": "node tools/dev.ts dev:mock",
    "doctor": "node tools/doctor/main.ts",
    "wireframes": "node tools/wireframes/build.ts"
  },
  "dependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/ws": "8.18.2",
    "smol-toml": "1.9.1",
    "unpdf": "1.4.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1"
  }
}
