import { type Blueprint, defineBlueprint } from "@lophn/blueprint";
import { IMPORT_DIR } from "./src/places.ts";
import { en } from "./src/wording/en.ts";

// blueprint가 정본이다. 코드를 바꾸기 전에 먼저 바꾼다.
// 사람에게 보이는 이름·설명은 en catalog 문구고, command·screen의 key는 문구와 별개의 식별자다.
// catalog 문구를 바꿔도 key는 같다(tests/wording_test.ts).
type Text = Readonly<Record<keyof typeof en, string>>;

export function makeBlueprint(text: Text = en): Blueprint {
  const day = (description: string) => ({
    type: "string",
    description,
    minLength: 10,
    maxLength: 10,
  } as const);

  return defineBlueprint({
    name: "Rate limit dashboard",
    description: text["common.summary.app"],
    screens: [
      {
        key: "usage",
        label: text["usage.title.screen"],
        path: "/screens/usage/index.html",
        // 같은 화면을 전체와 좁은 패널(320px)·카드(240px)에 모두 만들고 테스트한다.
        sizes: ["full", "panel", "card"],
      },
    ],
    commands: [
      {
        key: "usage_report",
        label: text["usage.label.usage-report"],
        description: text["usage.summary.usage-report"],
        effect: "read",
        confirm: false,
        input: {
          type: "object",
          properties: {
            from: day(text["usage.summary.from"]),
            to: day(text["usage.summary.to"]),
            timezone: {
              type: "string",
              description: text["usage.summary.timezone"],
              minLength: 1,
              maxLength: 64,
            },
            providers: {
              type: "array",
              description: text["usage.summary.providers"],
              items: { type: "string", minLength: 1, maxLength: 80 },
              maxItems: 50,
            },
            order: {
              type: "string",
              description: text["usage.summary.order"],
              enum: ["asc", "desc"],
              default: "asc",
            },
            limit: {
              type: "integer",
              description: text["usage.summary.limit"],
              minimum: 1,
              maximum: 500,
              default: 100,
            },
            continuation: {
              type: "string",
              description: text["usage.summary.continuation"],
              minLength: 1,
              maxLength: 2000,
            },
          },
          required: ["from", "to", "timezone"],
          additionalProperties: false,
        },
        revert: { supported: false },
      },
      {
        key: "collect_usage",
        label: text["usage.label.collect-usage"],
        description: text["usage.summary.collect-usage"],
        effect: "write",
        confirm: false,
        input: {
          type: "object",
          properties: {
            file: {
              type: "string",
              description: text["usage.summary.file-name"],
              minLength: 6,
              maxLength: 80,
            },
          },
          required: ["file"],
          additionalProperties: false,
        },
        revert: { supported: false },
      },
    ],
    automatic_tasks: [],
    permissions: [
      {
        kind: "fs.read",
        scope: { path: IMPORT_DIR, recursive: true },
        reason: text["common.reason.import-folder"],
      },
    ],
    // 선언한 code마다 실제 command의 실패 경로 test가 하나 이상 있어야 한다(tests/failure_path_test.ts).
    problem_codes: [
      {
        code: "store_unavailable",
        message_key: "common.problem.store-unavailable",
        message: text["common.problem.store-unavailable"],
        fixer: "coding_agent",
      },
      {
        code: "file_unavailable",
        message_key: "common.problem.file-unavailable",
        message: text["common.problem.file-unavailable"],
        fixer: "user",
      },
    ],
    documents: [],
    agent_context: [],
    app_connections: [],
    // 정확한 version만 쓴다. deno.json의 import map과 같아야 한다(tests/blueprint_test.ts).
    sdk_dependencies: [
      { name: "@lophn/blueprint", version: "1.0.0" },
      { name: "@lophn/cap-fs", version: "1.0.0" },
      { name: "@lophn/cap-problem", version: "1.0.0" },
      { name: "@lophn/cap-schedule", version: "1.0.0" },
      { name: "@lophn/cap-store", version: "1.0.0" },
      { name: "@lophn/design", version: "1.0.0" },
      { name: "@lophn/ui-chart", version: "1.0.0" },
      { name: "@lophn/ui-control", version: "1.0.0" },
      { name: "@lophn/ui-filter", version: "1.0.0" },
      { name: "@lophn/ui-layout", version: "1.0.0" },
      { name: "@lophn/ui-stat", version: "1.0.0" },
      { name: "@lophn/ui-state", version: "1.0.0" },
      { name: "@lophn/ui-table", version: "1.0.0" },
      { name: "@lophn/wording", version: "1.0.0" },
    ],
  });
}

export default makeBlueprint();
