{
  "schema": 1,
  "contract": {
    "types": [
      {
        "name": "Experiment",
        "summary": "One run comparing arms on scenarios",
        "visibility": "public",
        "source": {
          "kind": "series",
          "pattern": "eval/experiments/exp-{n:03}-*.md",
          "order": "natural"
        },
        "key": "id",
        "fields": [
          {
            "name": "id",
            "from": {
              "kind": "path",
              "capture": "n"
            },
            "value_type": "string",
            "required": false,
            "visibility": "public"
          },
          {
            "name": "title",
            "from": {
              "kind": "title"
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          },
          {
            "name": "status",
            "from": {
              "kind": "frontmatter",
              "key": "status"
            },
            "value_type": "enum",
            "values": [
              "planned",
              "running",
              "done"
            ],
            "required": true,
            "visibility": "public"
          },
          {
            "name": "scenarios",
            "from": {
              "kind": "frontmatter",
              "key": "scenarios"
            },
            "value_type": "list",
            "item_type": "string",
            "required": false,
            "visibility": "private"
          },
          {
            "name": "rubric",
            "from": {
              "kind": "frontmatter",
              "key": "rubric"
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          },
          {
            "name": "question",
            "from": {
              "kind": "section",
              "heading": "질문",
              "include_children": false
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          }
        ],
        "relations": [
          {
            "name": "runs_on",
            "label": "runs on",
            "to": "Scenario",
            "via": "scenarios",
            "cardinality": "many",
            "visibility": "public"
          },
          {
            "name": "graded_by",
            "label": "graded by",
            "to": "rubrics/Rubric",
            "via": "rubric",
            "cardinality": "optional",
            "visibility": "private"
          }
        ],
        "rules": [
          {
            "id": "status-required",
            "message": "Every experiment says its status",
            "kind": "required_field",
            "params": {
              "field": "status"
            }
          },
          {
            "id": "status-known",
            "message": "Status is planned, running or done",
            "kind": "enum_value",
            "params": {
              "field": "status"
            }
          },
          {
            "id": "scenarios-exist",
            "message": "Every scenario an experiment runs on exists",
            "kind": "relation_target_exists",
            "params": {
              "relation": "runs_on"
            }
          }
        ]
      },
      {
        "name": "Scenario",
        "summary": "A task the agent is graded on",
        "visibility": "public",
        "source": {
          "kind": "docs",
          "paths": [
            "eval/scenarios/*.md"
          ]
        },
        "key": "id",
        "fields": [
          {
            "name": "id",
            "from": {
              "kind": "path",
              "capture": "file"
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          },
          {
            "name": "title",
            "from": {
              "kind": "title"
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          }
        ],
        "relations": [],
        "rules": []
      },
      {
        "name": "Finding",
        "summary": "What an experiment showed",
        "visibility": "private",
        "source": {
          "kind": "series",
          "pattern": "loop/findings/F-{n:03}.md",
          "order": "natural"
        },
        "key": "id",
        "fields": [
          {
            "name": "id",
            "from": {
              "kind": "path",
              "capture": "n"
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          },
          {
            "name": "title",
            "from": {
              "kind": "title"
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          },
          {
            "name": "experiment",
            "from": {
              "kind": "frontmatter",
              "key": "experiment"
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          }
        ],
        "relations": [
          {
            "name": "about",
            "label": "about",
            "to": "Experiment",
            "via": "experiment",
            "cardinality": "one",
            "visibility": "private"
          }
        ],
        "rules": [
          {
            "id": "about-exists",
            "message": "A finding points at an experiment that exists",
            "kind": "relation_target_exists",
            "params": {
              "relation": "about"
            }
          }
        ]
      },
      {
        "name": "Decision",
        "summary": "One decision in the decision log",
        "visibility": "private",
        "source": {
          "kind": "section",
          "documents": [
            "docs/decisions.md"
          ],
          "level": 2
        },
        "key": "title",
        "fields": [
          {
            "name": "title",
            "from": {
              "kind": "title"
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          },
          {
            "name": "why",
            "from": {
              "kind": "section",
              "heading": "Why",
              "include_children": false
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          }
        ],
        "relations": [],
        "rules": []
      },
      {
        "name": "Guide",
        "summary": "A guide linked from the README",
        "visibility": "private",
        "source": {
          "kind": "index",
          "document": "docs/README.md"
        },
        "key": "id",
        "fields": [
          {
            "name": "id",
            "from": {
              "kind": "path",
              "capture": "file"
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          },
          {
            "name": "title",
            "from": {
              "kind": "title"
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          }
        ],
        "relations": [],
        "rules": []
      },
      {
        "name": "GuideHeading",
        "summary": "A heading inside a guide",
        "visibility": "private",
        "source": {
          "kind": "outline",
          "from_type": "Guide",
          "format": "markdown",
          "min_level": 1,
          "max_level": 3
        },
        "key": "title",
        "fields": [
          {
            "name": "title",
            "from": {
              "kind": "title"
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          }
        ],
        "relations": [],
        "rules": []
      },
      {
        "name": "Event",
        "summary": "A calendar event",
        "visibility": "private",
        "source": {
          "kind": "app-data",
          "app": "calendar",
          "command": "events.list",
          "result_path": [
            "items"
          ]
        },
        "key": "id",
        "fields": [
          {
            "name": "id",
            "from": {
              "kind": "item",
              "key_path": [
                "id"
              ]
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          },
          {
            "name": "title",
            "from": {
              "kind": "item",
              "key_path": [
                "summary"
              ]
            },
            "value_type": "string",
            "required": false,
            "visibility": "private"
          }
        ],
        "relations": [],
        "rules": []
      }
    ]
  },
  "searches": [
    {
      "name": "findings_for_experiment",
      "title": "Findings for an experiment",
      "inputs": [
        {
          "name": "experiment",
          "label": "Experiment",
          "type": "entity",
          "of": "Experiment",
          "many": false,
          "required": true
        }
      ],
      "query": {
        "from": "Finding",
        "where": {
          "path": "experiment",
          "op": "eq",
          "value": {
            "input": "experiment"
          }
        },
        "follow": [
          {
            "relation": "about",
            "as": "exp",
            "direction": "forward"
          }
        ],
        "sort": [
          {
            "path": "key",
            "dir": "desc"
          }
        ],
        "group": null
      },
      "result": {
        "kind": "table",
        "columns": [
          {
            "label": "Finding",
            "path": "key"
          },
          {
            "label": "Title",
            "path": "title"
          },
          {
            "label": "Experiment status",
            "path": "exp.status"
          }
        ],
        "page_size": 30
      }
    },
    {
      "name": "experiments_by_status",
      "title": "Experiments by status",
      "inputs": [
        {
          "name": "status",
          "label": "Status",
          "type": "value",
          "of": "Experiment.status",
          "many": true,
          "required": false
        }
      ],
      "query": {
        "from": "Experiment",
        "where": {
          "path": "status",
          "op": "in",
          "value": {
            "input": "status"
          }
        },
        "follow": [],
        "sort": [],
        "group": null
      },
      "result": {
        "kind": "board",
        "columns": [],
        "board_by": "status",
        "page_size": 30
      }
    },
    {
      "name": "experiments_on_scenario",
      "title": "Experiments that run on a scenario",
      "inputs": [
        {
          "name": "scenario",
          "label": "Scenario",
          "type": "entity",
          "of": "Scenario",
          "many": false,
          "required": true
        }
      ],
      "query": {
        "from": "Scenario",
        "where": {
          "path": "key",
          "op": "eq",
          "value": {
            "input": "scenario"
          }
        },
        "follow": [
          {
            "relation": "runs_on",
            "as": "exp",
            "direction": "reverse"
          }
        ],
        "sort": [],
        "group": null
      },
      "result": {
        "kind": "table",
        "columns": [
          {
            "label": "Experiment",
            "path": "exp.key"
          },
          {
            "label": "Status",
            "path": "exp.status"
          }
        ],
        "page_size": 30
      }
    }
  ],
  "saved_views": [
    {
      "name": "Running experiments",
      "search": "experiments_by_status",
      "inputs": {
        "status": [
          "running"
        ]
      }
    }
  ],
  "examples": [
    {
      "kind": "search",
      "search": "findings_for_experiment",
      "inputs": {
        "experiment": "008"
      },
      "expect_keys": [
        "009"
      ]
    },
    {
      "kind": "entity",
      "path": "eval/experiments/exp-008-sight.md",
      "section": null,
      "expect": {
        "type": "Experiment",
        "key": "008",
        "fields": {
          "status": "done"
        }
      }
    }
  ]
}
