// blueprint에 선언한 app-api의 handler. 선언한 key와 등록한 handler가 같아야 준비가 끝난다.
import {
  appApi,
  type AppApiClient,
  AppApiRejection,
  connectAppApi,
  readResult,
} from "@lophn/cap-app-api";
import { openStore, type Store } from "@lophn/cap-store";
import { reportProblem } from "@lophn/cap-problem";
import { formatLocal, toDate } from "@me/date-range";
import {
  addEvent,
  type CalendarEvent,
  ensureSchema,
  type EventRange,
  listEvents,
  rangeBounds,
  removeEvent,
} from "./events.ts";
import { NOTIFY_APP, scheduleReminder } from "./notify.ts";

export type Deps = {
  openStore: () => Store;
  now: () => string;
  notify: Pick<AppApiClient, "call">;
};

const defaults: Deps = {
  openStore: () => openStore(),
  now: () => new Date().toISOString(),
  notify: connectAppApi(NOTIFY_APP, ["notify.schedule"]),
};

// 저장소를 열고 일을 한다. 저장소를 여는 데 실패하거나 DB 질의가 실패하면 이름과 message로 보고하고
// 호출자에게는 이유 없는 거절만 돌려준다. DB를 건드리지 않는 계산은 work 밖에서 해야 한다. 그래야 그 오류가
// store_unavailable로 삼켜지지 않고 진입점이 stack과 함께 보고한다.
// 보고가 실패해도 업무 응답은 막지 않는다. 입력·DB 내용은 보고에 넣지 않는다.
// 연결은 process에 하나라 호출마다 닫지 않는다. write 호출의 변경 기록(changeset)이 연결에 걸려 있어서, 닫으면
// 그 호출의 변경이 사라져 되돌릴 수 없다.
async function withStore<T>(
  deps: Deps,
  name: string,
  work: (store: Store) => T,
): Promise<T> {
  try {
    const store = deps.openStore();
    await ensureSchema(store);
    return work(store);
  } catch {
    reportProblem(
      "store_unavailable",
      "the event store could not be used",
      { api: name },
    );
    throw new AppApiRejection(
      "unavailable",
      "the event store is unavailable",
    );
  }
}

export function listEventsHandler(deps: Deps = defaults) {
  return async (input: unknown) => {
    const range = (input as { range?: EventRange } | null)?.range ?? "all";
    const bounds = rangeBounds(range, new Date(deps.now()));
    return await withStore(
      deps,
      "event.list",
      (store) =>
        readResult<CalendarEvent>(listEvents(store, bounds), {
          coverage: "complete",
          freshness: "fresh",
        }),
    );
  };
}

export function addEventHandler(deps: Deps = defaults) {
  return async (input: unknown) => {
    const { title, start } = input as {
      title: string;
      start: Parameters<typeof toDate>[0];
    };
    const date = toDate(start);
    if (date === null) {
      reportProblem(
        "event_input_invalid",
        "the event start is not a real local time",
        { api: "event.add" },
      );
      throw new AppApiRejection(
        "invalid_input",
        "the event start is not a real local time",
      );
    }
    const local = formatLocal(date);
    const saved = await withStore(
      deps,
      "event.add",
      (store) => addEvent(store, title, local, deps.now()),
    );
    const reminder = await scheduleReminder(deps.notify, title, date);
    return { ...saved, reminder };
  };
}

export function removeEventHandler(deps: Deps = defaults) {
  return async (input: unknown) => {
    const { id } = input as { id: number };
    const removed = await withStore(
      deps,
      "event.remove",
      (store) => removeEvent(store, id),
    );
    return { id, removed };
  };
}

export function registerAppApis(deps: Deps = defaults): void {
  appApi("event.list", listEventsHandler(deps));
  appApi("event.add", addEventHandler(deps));
  appApi("event.remove", removeEventHandler(deps));
}
