-- 한 번 수집한 원천 구간이다. 이 구간 안에 표본이 없으면 "수집했는데 0건"이고, 어느 구간에도 들지 않으면 "미수집"이다.
create table collection (
  id integer primary key,
  from_at text not null,
  to_at text not null check (to_at > from_at),
  collected_at text not null
);
-- provider별 rate limit 사용 표본이다. used가 quota에 닿으면 그 시각에 제한에 걸린 것이다.
create table sample (
  id integer primary key,
  collection integer not null references collection (id) on delete cascade,
  provider text not null check (length(provider) between 1 and 80),
  at text not null,
  used integer not null check (used >= 0),
  quota integer not null check (quota > 0),
  unique (provider, at)
);
create index sample_at on sample (at, provider);
