// 화면 build. 개발 때 `deno task build`로 돌린다. src/screens/<key>/의 화면을 고정한 UI Package와 함께
// 묶어 dist/screens/<key>/에 index.html·main.js·main.js.map·main.css와 글꼴을 만든다. 운영은 build나 의존 다운로드를
// 하지 않고 release 준비가 bundle에 담은 이 결과만 읽는다(apps/sdk#R10, R34).
import * as esbuild from "esbuild";
import { denoPlugins } from "@luca/esbuild-deno-loader";
import { copyFile, mkdir, readFile, rm, writeFile } from "node:fs/promises";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const root = fileURLToPath(new URL("../", import.meta.url));
const MAP = join(root, ".lophn/import-map.json");

// 앱 source가 SDK component를 쓰는 지점에 bundle 위치(`data-lophn-at="<file>:<line>:<column>"`)를 싣는다.
// annotation이 이 위치를 main.js.map으로 원래 source 위치로 푼다. 앱 source의 jsx runtime만 이 파일이 대신한다.
const AT_RUNTIME = `
import { Fragment, jsx as jsx0, jsxs as jsxs0 } from "react/jsx-runtime";
const POSITION = /([^\\s()]+:\\d+:\\d+)\\)?\\s*$/;
function at() {
  const frame = (new Error().stack ?? "").split("\\n")[3] ?? "";
  return POSITION.exec(frame)?.[1];
}
function mark(type, props, position) {
  return typeof type === "string" || position === undefined
    ? props
    : { ...props, "data-lophn-at": position };
}
export { Fragment };
export const jsx = (type, props, key) => jsx0(type, mark(type, props, at()), key);
export const jsxs = (type, props, key) => jsxs0(type, mark(type, props, at()), key);
`;

function atRuntime(): esbuild.Plugin {
  return {
    name: "app-at-runtime",
    setup(build) {
      build.onResolve({ filter: /^react\/jsx-runtime$/ }, (args) =>
        args.namespace === "file" && args.importer.startsWith(join(root, "src/"))
          ? { path: "jsx-runtime", namespace: "app-at" }
          : undefined);
      build.onLoad({ filter: /.*/, namespace: "app-at" }, () => ({
        contents: AT_RUNTIME,
        loader: "js",
        resolveDir: root,
      }));
    },
  };
}

// CSS Modules·CSS·글꼴·svg는 import map이 가리키는 설치 사본의 파일을 esbuild loader로 읽는다.
function assets(imports: Record<string, string>): esbuild.Plugin {
  return {
    name: "app-assets",
    setup(build) {
      build.onResolve({ filter: /\.(css|woff2|svg)$/ }, (args) => {
        const mapped = imports[args.path];
        const base = args.importer.startsWith("file:")
          ? args.importer
          : pathToFileURL(args.importer).href;
        const url = mapped
          ? new URL(mapped)
          : args.path.startsWith("file:")
          ? new URL(args.path)
          : args.path.startsWith(".")
          ? new URL(args.path, base)
          : undefined;
        if (!url || url.protocol !== "file:") return undefined;
        return { path: fileURLToPath(url), namespace: "app-asset" };
      });
      build.onLoad({ filter: /.*/, namespace: "app-asset" }, async (args) => ({
        contents: await readFile(args.path),
        loader: args.path.endsWith(".svg")
          ? "text"
          : args.path.endsWith(".module.css")
          ? "local-css"
          : args.path.endsWith(".css")
          ? "css"
          : "file",
        resolveDir: dirname(args.path),
      }));
    },
  };
}

export async function build(): Promise<string[]> {
  let imports: Record<string, string>;
  try {
    imports = JSON.parse(await readFile(MAP, "utf8")).imports;
  } catch {
    throw new Error(
      ".lophn/import-map.json is missing. Create the app from the lophn template again.",
    );
  }
  const scratch = join(root, ".lophn/build-config.json");
  await writeFile(scratch, JSON.stringify({ imports }));
  const screens: string[] = [];
  try {
    for await (const entry of Deno.readDir(join(root, "src/screens"))) {
      if (entry.isDirectory) screens.push(entry.name);
    }
    for (const screen of screens.sort()) {
      const out = join(root, "dist/screens", screen);
      await rm(out, { recursive: true, force: true });
      await mkdir(out, { recursive: true });
      await esbuild.build({
        absWorkingDir: root,
        entryPoints: [join(root, "src/screens", screen, "main.tsx")],
        outdir: out,
        bundle: true,
        format: "esm",
        jsx: "automatic",
        minify: true,
        sourcemap: "external",
        sourcesContent: true,
        assetNames: "[name]",
        define: { "process.env.NODE_ENV": '"production"' },
        logLevel: "error",
        plugins: [
          atRuntime(),
          assets(imports),
          ...(denoPlugins({ configPath: scratch }) as esbuild.Plugin[]),
        ],
      });
      await copyFile(
        join(root, "src/screens", screen, "index.html"),
        join(out, "index.html"),
      );
    }
  } finally {
    await rm(scratch, { force: true });
    await esbuild.stop();
  }
  return screens;
}

if (import.meta.main) {
  await build();
}
