<!-- A widget with nothing to draw: one centred line (with lophn's mark for "Tap to choose"), no header or footer. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/lw_root"
  android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center"
  android:background="@drawable/lophn_widget_bg" android:paddingStart="12dp" android:paddingEnd="12dp" android:paddingTop="10dp" android:paddingBottom="10dp">
  <ImageView android:id="@+id/lw_mark" android:layout_width="28dp" android:layout_height="28dp" android:layout_marginBottom="8dp"
    android:src="@drawable/lophn_mark" android:importantForAccessibility="no" />
  <TextView android:id="@+id/lw_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center"
    android:textSize="13sp" android:lineHeight="18sp" android:fontFamily="@font/pretendard_regular" android:textColor="@color/lophn_w_text_secondary" />
</LinearLayout>
