// 시간대별 달력 날짜. 집계 기간의 "하루"는 요청한 시간대의 달력 날짜 하나다(UTC 하루가 아니다).

const formatters = new Map<string, Intl.DateTimeFormat>();

function formatter(timezone: string): Intl.DateTimeFormat {
  let found = formatters.get(timezone);
  if (found === undefined) {
    found = new Intl.DateTimeFormat("en-CA", {
      timeZone: timezone,
      year: "numeric",
      month: "2-digit",
      day: "2-digit",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hourCycle: "h23",
    });
    formatters.set(timezone, found);
  }
  return found;
}

// 모르는 시간대 이름은 거절 대상이다. Intl이 던지는 RangeError를 값으로 바꾼다.
export function isTimezone(value: unknown): value is string {
  if (typeof value !== "string" || value === "") return false;
  try {
    formatter(value);
    return true;
  } catch {
    return false;
  }
}

type Local = {
  y: number;
  m: number;
  d: number;
  h: number;
  mi: number;
  s: number;
};

function localParts(ms: number, timezone: string): Local {
  const found: Record<string, number> = {};
  for (const part of formatter(timezone).formatToParts(new Date(ms))) {
    if (part.type !== "literal") found[part.type] = Number(part.value);
  }
  return {
    y: found["year"],
    m: found["month"],
    d: found["day"],
    h: found["hour"],
    mi: found["minute"],
    s: found["second"],
  };
}

const two = (value: number) => String(value).padStart(2, "0");

// 그 순간이 속한 시간대의 달력 날짜(YYYY-MM-DD)다.
export function localDay(ms: number, timezone: string): string {
  const { y, m, d } = localParts(ms, timezone);
  return `${y}-${two(m)}-${two(d)}`;
}

function offsetMs(ms: number, timezone: string): number {
  const { y, m, d, h, mi, s } = localParts(ms, timezone);
  return Date.UTC(y, m - 1, d, h, mi, s) - Math.floor(ms / 1000) * 1000;
}

// 없는 날짜(2월 30일 같은)와 다른 모양은 undefined다.
export function parseDay(
  day: unknown,
): { y: number; m: number; d: number } | undefined {
  if (typeof day !== "string") return undefined;
  const match = /^(\d{4})-(\d{2})-(\d{2})$/.exec(day);
  if (!match) return undefined;
  const y = Number(match[1]);
  const m = Number(match[2]);
  const d = Number(match[3]);
  const date = new Date(Date.UTC(y, m - 1, d));
  return date.getUTCFullYear() === y && date.getUTCMonth() === m - 1 &&
      date.getUTCDate() === d
    ? { y, m, d }
    : undefined;
}

export function addDays(day: string, days: number): string {
  const { y, m, d } = parseDay(day)!;
  return new Date(Date.UTC(y, m - 1, d + days)).toISOString().slice(0, 10);
}

// 그 시간대에서 그 날 0시가 되는 순간(UTC ms)이다.
export function dayStart(day: string, timezone: string): number {
  const { y, m, d } = parseDay(day)!;
  const guess = Date.UTC(y, m - 1, d);
  const first = guess - offsetMs(guess, timezone);
  return guess - offsetMs(first, timezone);
}
