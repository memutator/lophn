// 수집·집계의 업무 규칙. 요구 번호별 확인은 test 이름이 가리킨다. 수집은 시험 전용 폴더의 파일을 읽고 외부 service에는
// 나가지 않는다.
import { assert, assertEquals, assertRejects } from "@std/assert";
import { CommandRejection } from "@lophn/cap-schedule";
import { collectUsageHandler, usageReportHandler } from "../src/commands.ts";
import type { Deps } from "../src/deps.ts";
import {
  depsAt,
  type Place,
  sample,
  withPlace,
  writeUsage,
} from "./support.ts";

type Report = {
  rows: {
    day: string;
    provider: string;
    samples: number;
    peak_percent: number;
    limited_samples: number;
  }[];
  coverage: string;
  freshness: string;
  continuation: string | null;
  period: {
    from: string;
    to: string;
    timezone: string;
    start_at: string;
    end_at: string;
  };
  collected_through: string | null;
  providers: string[];
};

async function collect(
  deps: Deps,
  place: Place,
  file: string,
  collection: Parameters<typeof writeUsage>[2],
) {
  await writeUsage(place, file, collection);
  return await collectUsageHandler(deps)({ file });
}

async function report(
  deps: Deps,
  input: Record<string, unknown>,
): Promise<Report> {
  return await usageReportHandler(deps)(input) as Report;
}

const WEEK = { from: "2026-10-01", to: "2026-10-05", timezone: "UTC" };

Deno.test("apps/invocations#R14: 수집했지만 0건인 기간과 수집하지 않은 기간은 응답이 다르다", async () => {
  await withPlace(async (place) => {
    const deps = depsAt(place);
    // 10월 1일부터 3일 0시까지 수집했고 그 안에 표본은 없었다.
    await collect(deps, place, "empty.json", {
      from: "2026-10-01T00:00:00Z",
      to: "2026-10-03T00:00:00Z",
      samples: [],
    });
    const zero = await report(deps, {
      from: "2026-10-01",
      to: "2026-10-02",
      timezone: "UTC",
    });
    const missing = await report(deps, {
      from: "2026-09-01",
      to: "2026-09-02",
      timezone: "UTC",
    });
    assertEquals(zero.rows, []);
    assertEquals(missing.rows, []);
    // 같은 0행이지만 앞은 수집한 사실이고 뒤는 알 수 없는 것이다.
    assertEquals([zero.coverage, zero.freshness], ["complete", "fresh"]);
    assertEquals([missing.coverage, missing.freshness], [
      "uncollected",
      "unknown",
    ]);
    assertEquals(zero.collected_through, "2026-10-03T00:00:00.000Z");
    assertEquals(missing.collected_through, null);
  });
});

Deno.test("apps/invocations#R14: 일부만 수집한 기간은 partial이고 수집이 뒤처졌으면 stale이다", async () => {
  await withPlace(async (place) => {
    const deps = depsAt(place);
    await collect(deps, place, "part.json", {
      from: "2026-10-01T00:00:00Z",
      to: "2026-10-03T00:00:00Z",
      samples: [sample("alpha", "2026-10-02T10:00:00Z", 40)],
    });
    // 10월 1~5일 중 앞 이틀만 수집했다. 끝난 날까지 닿았으므로 데이터는 그만큼 신선하지만 범위는 일부다.
    const partial = await report(deps, WEEK);
    assertEquals(partial.coverage, "partial");
    assertEquals(partial.rows.length, 1);
    // 지금(10월 5일 12시)까지의 기간인데 수집이 이틀 전에 멈췄다.
    assertEquals(partial.freshness, "stale");
    // 수집이 지금까지 닿으면 같은 기간이 complete·fresh다.
    await collect(deps, place, "rest.json", {
      from: "2026-10-03T00:00:00Z",
      to: "2026-10-05T12:00:00Z",
      samples: [],
    });
    const whole = await report(deps, WEEK);
    assertEquals(whole.coverage, "partial");
    assertEquals(whole.freshness, "fresh");
    const upTo = await report(deps, { ...WEEK, to: "2026-10-04" });
    assertEquals([upTo.coverage, upTo.freshness], ["complete", "fresh"]);
  });
});

Deno.test("problems/tests#R18: 집계는 요청한 기간·시간대의 달력 날짜로 묶고 기간과 시간대를 결과에 돌려준다", async () => {
  await withPlace(async (place) => {
    const deps = depsAt(place);
    await collect(deps, place, "tz.json", {
      from: "2026-09-30T00:00:00Z",
      to: "2026-10-04T00:00:00Z",
      samples: [
        // UTC로는 10월 1일 16시, 서울로는 10월 2일 1시다.
        sample("alpha", "2026-10-01T16:00:00Z", 100),
        sample("alpha", "2026-10-01T10:00:00Z", 30),
        sample("beta", "2026-10-02T03:00:00Z", 5, 10),
      ],
    });
    const utc = await report(deps, {
      from: "2026-10-01",
      to: "2026-10-02",
      timezone: "UTC",
    });
    const seoul = await report(deps, {
      from: "2026-10-01",
      to: "2026-10-02",
      timezone: "Asia/Seoul",
    });
    assertEquals(
      utc.rows.map((row) => [row.day, row.provider, row.samples]),
      [["2026-10-01", "alpha", 2], ["2026-10-02", "beta", 1]],
    );
    assertEquals(
      seoul.rows.map((row) => [row.day, row.provider, row.samples]),
      [
        ["2026-10-01", "alpha", 1],
        ["2026-10-02", "alpha", 1],
        ["2026-10-02", "beta", 1],
      ],
    );
    // 한도에 닿은 표본은 limited, 최대 사용률은 그날의 가장 높은 값이다.
    assertEquals(
      utc.rows.map((row) => [row.peak_percent, row.limited_samples]),
      [[100, 1], [50, 0]],
    );
    // 기간과 시간대가 결과에 그대로 있고 하루는 그 시간대의 0시부터다.
    assertEquals(seoul.period, {
      from: "2026-10-01",
      to: "2026-10-02",
      timezone: "Asia/Seoul",
      start_at: "2026-09-30T15:00:00.000Z",
      end_at: "2026-10-02T15:00:00.000Z",
    });
    assertEquals(seoul.providers, ["alpha", "beta"]);
    // 서머타임이 시작하는 날은 23시간이다.
    const spring = await report(deps, {
      from: "2026-03-08",
      to: "2026-03-08",
      timezone: "America/New_York",
    });
    assertEquals(
      Date.parse(spring.period.end_at) - Date.parse(spring.period.start_at),
      23 * 60 * 60 * 1000,
    );
    // 모르는 시간대, 거꾸로·너무 긴 기간, 없는 날짜는 입력 오류다.
    for (
      const bad of [
        { ...WEEK, timezone: "Mars/Olympus" },
        { ...WEEK, from: "2026-10-06" },
        { from: "2026-01-01", to: "2026-03-31", timezone: "UTC" },
        { ...WEEK, to: "2026-02-30" },
      ]
    ) {
      const error = await assertRejects(
        async () => await report(deps, bad),
        CommandRejection,
      );
      assertEquals(error.code, "invalid_input");
    }
  });
});

Deno.test("apps/invocations#R14: 이어 읽기는 처음 조건·정렬·데이터 기준이 바뀌면 거절한다", async () => {
  await withPlace(async (place) => {
    const deps = depsAt(place);
    const samples = ["01", "02", "03", "04"].flatMap((day) => [
      sample("alpha", `2026-10-${day}T09:00:00Z`, 10),
      sample("beta", `2026-10-${day}T09:00:00Z`, 20),
    ]);
    await collect(deps, place, "all.json", {
      from: "2026-10-01T00:00:00Z",
      to: "2026-10-05T12:00:00Z",
      samples,
    });
    const query = { ...WEEK, limit: 3 };
    const first = await report(deps, query);
    assertEquals(first.rows.length, 3);
    assert(first.continuation !== null);
    // 같은 조건으로 이어 읽으면 나머지가 겹침 없이 이어진다.
    const second = await report(deps, {
      ...query,
      continuation: first.continuation,
    });
    const third = await report(deps, {
      ...query,
      continuation: second.continuation,
    });
    assertEquals(
      [...first.rows, ...second.rows, ...third.rows].map((row) =>
        `${row.day}|${row.provider}`
      ),
      samples.map((item) => `${item.at.slice(0, 10)}|${item.provider}`).sort(),
    );
    assertEquals(third.continuation, null);

    const rejected = async (input: Record<string, unknown>) => {
      const error = await assertRejects(
        async () => await report(deps, input),
        CommandRejection,
      );
      assertEquals(error.code, "conflict");
    };
    // 기간·정렬·시간대·provider를 바꾸고 원래 이어 읽기를 재사용하면 거절된다.
    const token = first.continuation;
    await rejected({ ...query, to: "2026-10-04", continuation: token });
    await rejected({ ...query, order: "desc", continuation: token });
    await rejected({ ...query, timezone: "Asia/Seoul", continuation: token });
    await rejected({ ...query, providers: ["alpha"], continuation: token });
    // 새 수집이 들어와 데이터 기준이 바뀌어도 거절된다.
    await collect(deps, place, "more.json", {
      from: "2026-10-05T12:00:00Z",
      to: "2026-10-05T13:00:00Z",
      samples: [],
    });
    await rejected({ ...query, continuation: token });
    // 읽을 수 없는 이어 읽기는 입력 오류다.
    const garbage = await assertRejects(
      async () => await report(deps, { ...query, continuation: "nope" }),
      CommandRejection,
    );
    assertEquals(garbage.code, "invalid_input");
  });
});

Deno.test("apps/invocations#R14: 잘못된 수집 파일은 효과 없이 입력 오류로 거절한다", async () => {
  await withPlace(async (place) => {
    const deps = depsAt(place);
    for (
      const body of [
        "not json",
        JSON.stringify({
          from: "2026-10-02T00:00:00Z",
          to: "2026-10-01T00:00:00Z",
          samples: [],
        }),
        JSON.stringify({
          from: "2026-10-01T00:00:00Z",
          to: "2026-10-02T00:00:00Z",
          // 구간 밖 표본이다.
          samples: [sample("alpha", "2026-10-03T00:00:00Z", 1)],
        }),
      ]
    ) {
      await Deno.writeTextFile(`${place.imports}/bad.json`, body);
      const error = await assertRejects(
        async () => await collectUsageHandler(deps)({ file: "bad.json" }),
        CommandRejection,
      );
      assertEquals(error.code, "invalid_input");
    }
    // 아무것도 저장되지 않았다.
    const after = await report(deps, WEEK);
    assertEquals(after.coverage, "uncollected");
  });
});
