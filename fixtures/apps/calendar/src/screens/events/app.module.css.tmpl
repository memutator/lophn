/* 간격은 token만 쓴다. 색·글꼴은 design이 정한다. */
.form {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  padding: var(--space-6);
}

/* 주 행동은 줄 오른쪽 끝에 둔다. */
.actions {
  display: flex;
  justify-content: flex-end;
  flex-wrap: wrap;
  gap: var(--space-4);
}

.count {
  margin: 0;
  padding: 0 var(--space-6) var(--space-4);
}

.list {
  margin: 0;
  padding: 0 var(--space-6) var(--space-6);
  list-style: none;
  display: flex;
  flex-direction: column;
  gap: var(--space-4);
}

/* panel 폭에서는 제목 아래로 시각이 내려온다. */
.event {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: var(--space-2) var(--space-6);
  overflow-wrap: anywhere;
}
