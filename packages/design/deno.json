    "./input": "./components/input/mod.ts",
    "./layout": "./components/layout/mod.ts",
    "./navigation": "./components/navigation/mod.ts",
    "./data": "./components/data/mod.ts",
    "./feedback": "./components/feedback/mod.ts",
    "./overlay": "./components/overlay/mod.ts",
    "./reading": "./components/reading/mod.ts",
    "./shared": "./components/_shared/mod.ts",
    "./base.css": "./base.css",
    "./tokens.css": "./generated/tokens.css"
  },
  "imports": {
    "postcss": "npm:postcss@8.5.28",
    "postcss-value-parser": "npm:postcss-value-parser@4.2.0",
    "react": "npm:react@19.3.0",
    "react-dom": "npm:react-dom@19.3.0",
    "react-dom/client": "npm:react-dom@19.3.0/client",
    "@types/react": "npm:@types/react@19.3.0",
    "@radix-ui/react-checkbox": "npm:@radix-ui/react-checkbox@1.3.11",
    "@radix-ui/react-dialog": "npm:@radix-ui/react-dialog@1.1.23",
    "@radix-ui/react-dropdown-menu": "npm:@radix-ui/react-dropdown-menu@2.1.24",
    "@radix-ui/react-popover": "npm:@radix-ui/react-popover@1.1.23",
    "@radix-ui/react-select": "npm:@radix-ui/react-select@2.3.7",
    "@radix-ui/react-switch": "npm:@radix-ui/react-switch@1.3.7",
