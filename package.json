{
  "name": "lophn",
  "version": "0.23.164",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "!packages/mobile",
    "packages/sdk/*",
    "packages/shell/main",
    "packages/shell/renderer",
    "tools/wireframes",
    "packages/design/i18n"
  ],
  "scripts": {
    "check": "node tools/check.ts",
    "check:full": "node tools/check.ts --full",
    "install-checklist": "node tools/install-checklist.ts",
    "e2e": "node tools/electron-node.ts --test --test-concurrency=1 \"tests/e2e/*_test.ts\"",
    "e2e:deps": "node tools/electron-node.ts tests/support/app/prepare-deps.ts",
    "test:live": "node --env-file=.env tests/live/run.ts",
    "test:live:login": "node tests/live/login.ts",
    "dev": "node tools/dev.ts dev",
    "dev:core": "node tools/dev.ts dev:core",
    "dev:remote": "node tools/remote-dev.ts",
    "dev:relay": "node packages/relay/main.ts --port 8787",
    "dev:mock": "node tools/dev.ts dev:mock",
    "doctor": "node tools/doctor/main.ts",
    "wireframes": "node tools/wireframes/build.ts",
    "wireframes:smoke": "node tools/wireframes/smoke.ts",
    "package": "node tools/package/main.ts"
  },
  "dependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/ws": "8.18.2",
    "@xterm/addon-serialize": "0.14.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/headless": "6.0.0",
    "smol-toml": "1.9.1",
    "unpdf": "1.4.0",
    "ws": "8.22.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.1"
  },
  "overrides": {
    "@anthropic-ai/claude-agent-sdk-linux-x64": "file:./tools/empty-package",
    "@anthropic-ai/claude-agent-sdk-linux-arm64": "file:./tools/empty-package",
    "@anthropic-ai/claude-agent-sdk-linux-x64-musl": "file:./tools/empty-package",
    "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": "file:./tools/empty-package",
    "@anthropic-ai/claude-agent-sdk-darwin-x64": "file:./tools/empty-package",
    "@anthropic-ai/claude-agent-sdk-darwin-arm64": "file:./tools/empty-package",
    "@anthropic-ai/claude-agent-sdk-win32-x64": "file:./tools/empty-package",
    "@anthropic-ai/claude-agent-sdk-win32-arm64": "file:./tools/empty-package"
  }
}
