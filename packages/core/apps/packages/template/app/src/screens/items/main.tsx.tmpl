import { createRoot } from "react-dom/client";
import "@lophn/design/tokens.css";
import "@lophn/design/base.css";
import { AppErrorBoundary } from "@lophn/ui-state";
import { App } from "./app.tsx";

// 화면 root는 AppErrorBoundary로 감싼다. render 오류는 lophn 오류 수집으로 전달되고 화면에는 원문 없이
// 한 문장과 다시 시도만 남는다(apps/sdk#R29). 지우지 않는다.
const root = document.getElementById("root");
if (root) {
  createRoot(root).render(
    <AppErrorBoundary>
      <App />
    </AppErrorBoundary>,
  );
}
