{
  "name": "@lophn/design",
  "exports": {
    ".": "./mod.ts",
    "./base.css": "./base.css",
    "./tokens.css": "./generated/tokens.css"
  },
  "imports": {
    "postcss": "npm:postcss@8.5.28",
