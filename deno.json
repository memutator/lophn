{
  "workspace": [
    "./packages/*",
    "./packages/sdk/*",
    "./packages/shell/renderer",
    "./tools/wireframes",
    "./packages/design/wording"
  ],
  "lock": {
    "frozen": true
  },
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno run --allow-all tools/check.ts",
    "check:full": "deno run --allow-all tools/check.ts --full",
    "eval": "deno run --allow-all --env-file=.env tests/eval/run.ts",
    "eval:answer": "deno run --allow-all tests/eval/human/main.ts",
    "eval:experiment": "deno run --allow-all --env-file=.env tests/eval/run.ts experiment",
    "eval:gate": "deno run --allow-all tests/eval/run.ts gate",
    "eval:judge": "deno run --allow-all tests/eval/judge/main.ts",
    "eval:scorecard": "deno run --allow-all tests/eval/scorecard/main.ts",
    "wording": "deno run --allow-read --allow-write packages/design/wording/generate.ts",
    "e2e": "deno test --allow-all --no-check tests/e2e",
    "e2e:deps": "deno run --allow-all tests/support/app/prepare-deps.ts",
    "test:live": "deno run --allow-all --env-file=.env tests/live/run.ts",
    "test:live:login": "deno run --allow-all tests/live/login.ts",
    "dev": "deno run --allow-all tools/dev.ts dev",
    "dev:core": "deno run --allow-all tools/dev.ts dev:core",
    "dev:mock": "deno run --allow-all tools/dev.ts dev:mock",
    "wireframes": "deno run --allow-read --allow-write --allow-run --allow-env tools/wireframes/build.ts"
  },
  "exclude": [
    ".claude",
    ".dev-data",
    "project-docs",
    "packages/shell/main",
    "packages/shell/preload",
    "dist",
    "build",
    "node_modules"
  ],
  "compilerOptions": {
    "verbatimModuleSyntax": true,
    "lib": ["deno.window", "esnext"]
  }
}
