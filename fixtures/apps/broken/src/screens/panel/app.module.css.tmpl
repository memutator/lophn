/* 간격은 token만 쓴다. 색·글꼴은 design이 정한다. panel(320px)에서도 가로 scroll이 없도록 줄은 줄바꿈한다. */
.form {
  display: flex;
  flex-direction: column;
  gap: var(--space-6);
  padding: var(--space-6);
}

/* 주 행동은 줄 오른쪽 끝에 둔다. */
.actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: var(--space-4);
}

.notice {
  margin: 0;
  padding: 0 var(--space-6);
}

.count {
  margin: 0;
  padding: 0 var(--space-6);
}
