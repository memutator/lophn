import { assertEquals, assertRejects } from "@std/assert";
import { AppApiRejection } from "@lophn/cap-app-api";
import { openStore, type Store } from "@lophn/cap-store";
import {
  listRemindersHandler,
  scheduleReminderHandler,
} from "../src/app-api.ts";

// 앱 DB는 test 전용 폴더에 만든다. 운영 DB와 다른 앱의 DB는 열지 않는다.
async function withData<T>(work: (dataPath: string) => Promise<T>): Promise<T> {
  const dir = await Deno.makeTempDir({ prefix: "app-reminders-" });
  try {
    return await work(dir);
  } finally {
    await Deno.remove(dir, { recursive: true });
  }
}

function depsAt(dataPath: string) {
  let store: Store | undefined;
  return {
    openStore: () => store ??= openStore({ host: { mode: "test", dataPath } }),
    now: () => "2026-02-01T00:00:00.000Z",
  };
}

Deno.test("reminders: notify.schedule stores a row and notify.list returns rows by time with a local time", async () => {
  await withData(async (dataPath) => {
    const deps = depsAt(dataPath);
    const late = new Date(2026, 6, 15, 18, 5).getTime();
    const early = new Date(2026, 6, 15, 9, 30).getTime();
    await scheduleReminderHandler(deps)({ title: "Late", at: late });
    const saved = await scheduleReminderHandler(deps)({
      title: "Early",
      at: early,
    });
    assertEquals(saved, { id: 2, title: "Early", at: early });
    const result = await listRemindersHandler(deps)();
    assertEquals(result.rows.map((row) => row.title), ["Early", "Late"]);
    assertEquals(result.rows[0].at_local, "2026-07-15T09:30");
    assertEquals(result.coverage, "complete");
    assertEquals(result.freshness, "fresh");
  });
});

Deno.test("reminders: notify.schedule rejects a time that is not a valid date before touching the store", async () => {
  const deps = {
    openStore: () => {
      throw new Error("must not open");
    },
    now: () => "2026-02-01T00:00:00.000Z",
  };
  await assertRejects(
    async () =>
      await scheduleReminderHandler(deps)({ title: "x", at: 8.64e15 + 1 }),
    AppApiRejection,
  );
});
