@@ -0,0 +1,71 @@
+package io.callstack.rnsandbox
+
+// lophn: a guest has no network, and images are a way out too: an <Image> with an http URL or Image.prefetch sends a
+// request (with whatever the screen put in the URL) through the host's Fresco pipeline. A guest gets an image view
+// whose loads of network URIs fail and an ImageLoader that refuses every call. Files are the same: a guest draws a `file:`
+// URI only from `imageFolder` (the host's file place for this guest) and never a `content:` URI.
+
+import android.content.Context
+import com.facebook.common.executors.UiThreadImmediateExecutorService
+import com.facebook.drawee.backends.pipeline.Fresco
+import com.facebook.drawee.backends.pipeline.PipelineDraweeControllerFactory
+import com.facebook.drawee.components.DeferredReleaser
+import com.facebook.fbreact.specs.NativeImageLoaderAndroidSpec
+import com.facebook.react.bridge.Arguments
+import com.facebook.react.bridge.Promise
+import com.facebook.react.bridge.ReactApplicationContext
+import com.facebook.react.bridge.ReadableArray
+import com.facebook.react.bridge.ReadableMap
+import com.facebook.react.views.image.ReactImageManager
+
+private const val NO_NETWORK = "a phone screen has no network"
+
+// The same image view manager as React Native's, over a controller builder made like Fresco's own
+// (PipelineDraweeControllerBuilderSupplier) but refusing network URIs and files outside `imageFolder`.
+internal fun guestImageManager(
+    context: Context,
+    imageFolder: String?,
+): ReactImageManager {
+    val pipelineFactory = Fresco.getImagePipelineFactory()
+    val pipeline = pipelineFactory.imagePipeline
+    val factory = PipelineDraweeControllerFactory()
+    factory.init(
+        context.resources,
+        DeferredReleaser.getInstance(),
+        pipelineFactory.getAnimatedDrawableFactory(context),
+        pipelineFactory.xmlDrawableFactory,
+        UiThreadImmediateExecutorService.getInstance(),
+        pipeline.bitmapMemoryCache,
+        null,
+        null,
+    )
+    return ReactImageManager(GuestImageControllerBuilder(context, factory, pipeline, imageFolder))
+}
+
+internal class GuestImageLoaderModule(
+    reactContext: ReactApplicationContext,
+) : NativeImageLoaderAndroidSpec(reactContext) {
+    override fun getSize(
+        uri: String?,
+        promise: Promise,
+    ) = promise.reject("E_UNAVAILABLE", NO_NETWORK)
+
+    override fun getSizeWithHeaders(
+        uri: String?,
+        headers: ReadableMap?,
+        promise: Promise,
+    ) = promise.reject("E_UNAVAILABLE", NO_NETWORK)
+
+    override fun prefetchImage(
+        uri: String?,
+        requestId: Double,
+        promise: Promise,
+    ) = promise.reject("E_UNAVAILABLE", NO_NETWORK)
+
+    override fun abortRequest(requestId: Double) = Unit
+
+    override fun queryCache(
+        uris: ReadableArray,
+        promise: Promise,
+    ) = promise.resolve(Arguments.createMap())
+}
