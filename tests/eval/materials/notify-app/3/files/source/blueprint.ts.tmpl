import { type Blueprint, defineBlueprint } from "@lophn/blueprint";
import { en } from "./src/wording/en.ts";

// blueprint가 정본이다. 코드를 바꾸기 전에 먼저 바꾼다.
// 사람에게 보이는 이름·설명은 en catalog 문구고, tool 이름·screen의 key는 문구와 별개의 식별자다.
// catalog 문구를 바꿔도 key는 같다(tests/wording_test.ts).
type Text = Readonly<Record<keyof typeof en, string>>;

export function makeBlueprint(text: Text = en): Blueprint {
  return defineBlueprint({
    name: "알림",
    description: text["common.summary.app"],
    screens: [
      {
        key: "reminders",
        label: text["reminders.title.screen"],
        path: "/screens/reminders/index.html",
        sizes: ["full", "panel", "card"],
      },
    ],
    tools: [
      {
        name: "notify.list",
        title: text["reminders.label.list"],
        description: text["reminders.summary.list"],
        effect: "read",
        inputSchema: null,
        domain: "notify",
        public: true,
      },
      {
        name: "notify.schedule",
        title: text["reminders.label.schedule"],
        description: text["reminders.summary.schedule"],
        effect: "write",
        inputSchema: {
          type: "object",
          properties: {
            title: {
              type: "string",
              description: text["reminders.summary.reminder-title"],
              minLength: 1,
              maxLength: 200,
            },
            at: {
              type: "integer",
              description: text["reminders.summary.reminder-time"],
              minimum: 0,
            },
          },
          required: ["title", "at"],
          additionalProperties: false,
        },
        domain: "notify",
        public: true,
      },
    ],
    permissions: [],
    app_connections: [],
    // 정확한 version만 쓴다. deno.json의 import map과 같아야 한다(tests/blueprint_test.ts).
    sdk_dependencies: [
      { name: "@lophn/blueprint", version: "1.0.0" },
      { name: "@lophn/cap-problem", version: "1.0.0" },
      { name: "@lophn/cap-tool", version: "1.0.0" },
      { name: "@lophn/cap-store", version: "1.0.0" },
      { name: "@lophn/ui", version: "1.0.0" },
      { name: "@lophn/app-ui", version: "1.0.0" },
      { name: "@lophn/wording", version: "1.0.0" },
    ],
  });
}

export default makeBlueprint();
