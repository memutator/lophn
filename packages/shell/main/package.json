{
  "name": "lophn-shell-main",
  "private": true,
  "type": "module",
  "main": "dist/main.cjs",
  "description": "lophn desktop",
  "desktopName": "lophn.desktop",
  "author": "lophn developers <lophn@localhost>",
  "version": "0.10.1",
  "scripts": {
    "build": "node build.ts",
    "rebuild": "electron-rebuild -f -m ../../../node_modules/node-pty",
    "dev": "node build.ts && electron dist/main.cjs",
    "stage": "node --experimental-strip-types scripts/stage.ts",
    "dist": "npm run build && npm run stage && electron-builder",
    "check": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.node.json",
    "postinstall": "electron-rebuild -f -m ../../../node_modules/node-pty"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/node": "24.19.1",
    "electron": "44.5.1",
    "electron-builder": "25.1.7",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
