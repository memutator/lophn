    "@radix-ui/react-tooltip": "npm:@radix-ui/react-tooltip@1.2.16",
    "lucide-react": "npm:lucide-react@1.51.0",
    "@iconify-json/catppuccin/": "npm:/@iconify-json/catppuccin@1.2.17/",
    "@lezer/markdown": "npm:@lezer/markdown@1.7.2",
