{
  "workspace": [
    "./packages/*",
    "./packages/sdk/*",
    "./apps/*",
    "./apps/shell/renderer",
    "./apps/shell/gallery",
    "./packages/design/wording"
  ],
  "lock": {
    "frozen": true
  },
  "imports": {
    "zod": "npm:zod@4.6.5",
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "tasks": {
    "check": "deno run --allow-all tools/check.ts",
    "contracts:coverage": "deno run --allow-read tools/contract-coverage.ts"
  },
  "fmt": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.json",
      "**/*.jsonc"
    ],
    "exclude": [
      "node_modules",
      ".dev-data",
      ".claude",
      "dist"
    ]
  },
  "lint": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js"
    ],
    "exclude": [
      "node_modules",
      ".dev-data",
      ".claude",
      "dist"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "test": {
    "exclude": [
      "e2e",
      "apps/shell/main",
      "apps/shell/preload"
    ]
  },
  "exclude": [
    ".claude",
    ".dev-data",
    "apps/shell/main",
    "apps/shell/preload",
    "dist",
    "node_modules",
    "tools/check-docs.ts"
  ]
}
