{
  // desktop main·core·wiring과 terminal host CLI는 esbuild가 묶는 runtime 코드라 tsconfig.json에서 뺀다.
  // noUncheckedIndexedAccess를 켜면 함께 보는 packages/base가 오류를 내므로 이 project에서는 끈다.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "desktop/main.ts",
    "desktop/gui-window.ts",
    "desktop/core/**/*.ts",
    "desktop/wiring/**/*.ts",
    "../terminal-host/cli.ts"
  ],
  "exclude": []
}
