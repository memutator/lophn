import type { MessageKey } from "./en.ts";

export type PlaceholderKinds = {
  "common.summary.app": Record<never, never>;
  "events.button.add": Record<never, never>;
  "events.button.all": Record<never, never>;
  "events.button.next-week": Record<never, never>;
  "events.button.reload": Record<never, never>;
  "events.button.remove": Record<never, never>;
  "events.button.this-week": Record<never, never>;
  "events.empty.none": Record<never, never>;
  "events.error.save-failed": Record<never, never>;
  "events.label.add-event": Record<never, never>;
  "events.label.count": {
    count: "plural";
  };
  "events.label.events": Record<never, never>;
  "events.label.list-events": Record<never, never>;
  "events.label.new-event": Record<never, never>;
  "events.label.remove-event": Record<never, never>;
  "events.label.start": Record<never, never>;
  "events.summary.add-event": Record<never, never>;
  "events.summary.event-id": Record<never, never>;
  "events.summary.event-start": Record<never, never>;
  "events.summary.event-title": Record<never, never>;
  "events.summary.list-events": Record<never, never>;
  "events.summary.notify-reason": Record<never, never>;
  "events.summary.range": Record<never, never>;
  "events.summary.remove-event": Record<never, never>;
  "events.summary.start-day": Record<never, never>;
  "events.summary.start-hour": Record<never, never>;
  "events.summary.start-minute": Record<never, never>;
  "events.summary.start-month": Record<never, never>;
  "events.summary.start-year": Record<never, never>;
  "events.title.screen": Record<never, never>;
};

type ValueFor<T> = T extends "plural" | "number" ? number
  : T extends "date" ? Date
  : string;

export type ValuesOf<K extends MessageKey> = {
  [P in keyof PlaceholderKinds[K]]: ValueFor<PlaceholderKinds[K][P]>;
};

export type HasPlaceholders<K extends MessageKey> = [
  keyof PlaceholderKinds[K],
] extends [never] ? false
  : true;

type _SameKeys =
  | Exclude<MessageKey, keyof PlaceholderKinds>
  | Exclude<keyof PlaceholderKinds, MessageKey>;
const _sameKeys: [_SameKeys] extends [never] ? true : never = true;
void _sameKeys;
