+package io.callstack.rnsandbox;
+
+// lophn: Fresco's controller builder for a guest's image views: a guest draws no network image, no `content:` image and no
+// `file:` image outside the one folder the host gave it (its file place); see GuestImages.kt.
+//
+// Why `build()` and not the data source. ReactImageView sets the main request, the low-resolution request and (for several
+// sources) the first-available requests on the builder and calls `build()`. The controller `build()` makes looks a finished
+// image up in Fresco's bitmap memory cache by the cache key of the main request BEFORE it asks any data source, and that cache
+// is shared by the whole process and keyed by URI: a file the host or another guest already drew would be served without a
+// check on the data source running. So the check is made here, on every request the builder holds, before the controller
+// exists. A request that is not allowed is removed (the controller then has no cache key to look up) and the controller is
+// given a data source supplier that only fails, so there is nothing a cache can answer.
+//
+// The builder is shared: ReactImageManager gives every image view of a guest this one instance, and each view does
+// `reset()`, sets its requests, `build()`, `reset()`. Fresco's `reset()` clears the requests but NOT the data source supplier,
+// so a supplier left behind would make the next image's `build()` fail Fresco's validation ("Cannot specify DataSourceSupplier
+// with other ImageRequests"). `build()` therefore clears the supplier again before it returns, whatever happened: every build
+// starts and ends with no supplier set.
+// Java because Fresco passes a null caller context where its signature says non-null, which Kotlin would reject.
+
+import android.content.Context;
+import android.net.Uri;
+import com.facebook.common.internal.Supplier;
+import com.facebook.common.references.CloseableReference;
+import com.facebook.common.util.UriUtil;
+import com.facebook.datasource.DataSource;
+import com.facebook.datasource.DataSources;
+import com.facebook.drawee.backends.pipeline.PipelineDraweeControllerBuilder;
+import com.facebook.drawee.backends.pipeline.PipelineDraweeControllerFactory;
+import com.facebook.drawee.controller.AbstractDraweeController;
+import com.facebook.imagepipeline.core.ImagePipeline;
+import com.facebook.imagepipeline.image.CloseableImage;
+import com.facebook.imagepipeline.request.ImageRequest;
+import java.io.File;
+import java.io.IOException;
+import java.util.Collections;
+
+class GuestImageControllerBuilder extends PipelineDraweeControllerBuilder {
+  // Canonical path of the only folder a guest may draw files from; null when the host gave none.
+  private final String allowedFolder;
+
+  GuestImageControllerBuilder(
+      Context context,
+      PipelineDraweeControllerFactory factory,
+      ImagePipeline pipeline,
+      String imageFolder) {
+    super(context, factory, pipeline, Collections.emptySet(), Collections.emptySet());
+    String canonical = null;
+    if (imageFolder != null && !imageFolder.isEmpty()) {
+      try {
+        canonical = new File(imageFolder).getCanonicalPath();
+      } catch (IOException e) {
+        canonical = null;
+      }
+    }
+    this.allowedFolder = canonical;
+  }
+
+  // `data:`, `res:` and `asset:` stay as they were; a `file:` URI must name a file under the folder (symlinks and `..`
+  // resolved), `content:` reaches other apps' providers and a network URI is a way out: none of those load.
+  private boolean allowed(ImageRequest request) {
+    if (request == null) return true;
+    Uri uri = request.getSourceUri();
+    if (UriUtil.isNetworkUri(uri)) return false;
+    String scheme = uri.getScheme();
+    if ("content".equals(scheme)) return false;
+    if (!"file".equals(scheme)) return true;
+    if (allowedFolder == null || uri.getPath() == null) return false;
+    try {
+      return new File(uri.getPath()).getCanonicalPath().startsWith(allowedFolder + File.separator);
+    } catch (IOException e) {
+      return false;
+    }
+  }
+
+  @Override
+  public AbstractDraweeController build() {
+    boolean ok = allowed(getImageRequest()) && allowed(getLowResImageRequest());
+    ImageRequest[] first = getFirstAvailableImageRequests();
+    if (first != null) {
+      for (ImageRequest request : first) {
+        if (!allowed(request)) ok = false;
+      }
+    }
+    if (!ok) {
+      setImageRequest(null);
+      setLowResImageRequest(null);
+      setFirstAvailableImageRequests((ImageRequest[]) null);
+      setDataSourceSupplier(
+          new Supplier<DataSource<CloseableReference<CloseableImage>>>() {
+            @Override
+            public DataSource<CloseableReference<CloseableImage>> get() {
+              return DataSources.immediateFailedDataSource(
+                  new SecurityException("a phone screen draws only its own files"));
+            }
+          });
+    }
+    try {
+      return super.build();
+    } finally {
+      // The controller took the supplier when it was initialised; the shared builder must not keep it.
+      if (!ok) setDataSourceSupplier(null);
+    }
+  }
+}
