import { assertEquals, assertRejects } from "@std/assert";
import { ToolRejection } from "@lophn/cap-tool";
import { openStore, type Store } from "@lophn/cap-store";
import {
  addEventHandler,
  type Deps,
  listEventsHandler,
  removeEventHandler,
} from "../src/tools.ts";

// reportProblem은 앱 log에 `error <name>…` 한 줄을 쓴다(console.error). test마다 그 줄에서 이름만 모은다.
const reported: string[] = [];
const REPORT_LINE = /^(?:\[inv=[^\]]*\] )?error ([\w.-]+)/;

type Call = { api: string; input: { title: string; at: number } };

function fakeNotify(ok: boolean, calls: Call[]): Deps["notify"] {
  return {
    callTool: (api, input) => {
      calls.push({ api, input: input as Call["input"] });
      return Promise.resolve(
        ok
          ? {
            ok: true,
            value: {
              invocation: null,
              outcome: { status: "succeeded", result: {} },
            },
          }
          : { ok: false, error: { code: "unavailable", message: "down" } },
      );
    },
  };
}

// 앱 DB는 test 전용 폴더에 만든다. 운영 DB와 다른 앱의 DB는 열지 않는다.
async function withDeps<T>(
  work: (deps: Deps, calls: Call[]) => Promise<T>,
  options: { notifyOk?: boolean; now?: string } = {},
): Promise<T> {
  reported.length = 0;
  const writeError = console.error;
  console.error = (...args: unknown[]) => {
    const found = REPORT_LINE.exec(String(args[0]));
    if (found) reported.push(found[1]!);
    else writeError(...args);
  };
  const dir = await Deno.makeTempDir({ prefix: "app-events-" });
  let store: Store | undefined;
  const calls: Call[] = [];
  try {
    return await work({
      openStore: () =>
        store ??= openStore({ host: { mode: "test", dataPath: dir } }),
      // 2026-07-15는 수요일이다. 지역 시각으로 만든 Date의 ISO라 주 경계가 test 장치의 시간대와 무관하다.
      now: () => options.now ?? new Date(2026, 6, 15, 12, 0).toISOString(),
      notify: fakeNotify(options.notifyOk ?? true, calls),
    }, calls);
  } finally {
    console.error = writeError;
    store?.close();
    await Deno.remove(dir, { recursive: true });
  }
}

const at = (month: number, day: number, hour = 9, minute = 0) => ({
  year: 2026,
  month,
  day,
  hour,
  minute,
});

Deno.test("events: event.add saves the event and schedules a reminder 10 minutes before the start", async () => {
  await withDeps(async (deps, calls) => {
    const saved = await addEventHandler(deps)({
      title: "Standup",
      start: at(7, 15, 9, 30),
    });
    assertEquals(saved, {
      id: 1,
      title: "Standup",
      start: "2026-07-15T09:30",
      reminder: "scheduled",
    });
    assertEquals(calls, [{
      api: "notify.schedule",
      input: {
        title: "Standup",
        at: new Date(2026, 6, 15, 9, 20).getTime(),
      },
    }]);
  });
});

Deno.test("events: a failed reminder call keeps the event, answers reminder failed and reports notify_call_failed", async () => {
  await withDeps(async (deps) => {
    const saved = await addEventHandler(deps)({
      title: "Standup",
      start: at(7, 15),
    }) as { reminder: string };
    assertEquals(saved.reminder, "failed");
    assertEquals(reported, ["notify_call_failed"]);
    const listed = await listEventsHandler(deps)({});
    assertEquals(listed.rows.map((row) => row.title), ["Standup"]);
  }, { notifyOk: false });
});

Deno.test("events: a time that does not exist is rejected and reported as event_input_invalid", async () => {
  await withDeps(async (deps, calls) => {
    await assertRejects(
      async () => await addEventHandler(deps)({ title: "x", start: at(2, 30) }),
      ToolRejection,
    );
    assertEquals(reported, ["event_input_invalid"]);
    assertEquals(calls, []);
  });
});

Deno.test("events: event.list splits this week, next week and all with weeks starting on Monday 00:00", async () => {
  await withDeps(async (deps) => {
    const add = addEventHandler(deps);
    await add({ title: "last Sunday", start: at(7, 12, 23, 59) });
    await add({ title: "Monday", start: at(7, 13, 0, 0) });
    await add({ title: "Sunday", start: at(7, 19, 23, 59) });
    await add({ title: "next Monday", start: at(7, 20, 0, 0) });
    const list = async (range?: string) =>
      (await listEventsHandler(deps)(range ? { range } : {})).rows.map((row) =>
        row.title
      );
    assertEquals(await list("this_week"), ["Monday", "Sunday"]);
    assertEquals(await list("next_week"), ["next Monday"]);
    assertEquals(await list("all"), [
      "last Sunday",
      "Monday",
      "Sunday",
      "next Monday",
    ]);
    assertEquals(await list(), await list("all"));
  });
});

Deno.test("events: event.remove deletes the row and a missing id is not an error", async () => {
  await withDeps(async (deps) => {
    await addEventHandler(deps)({ title: "x", start: at(7, 15) });
    assertEquals(await removeEventHandler(deps)({ id: 1 }), {
      id: 1,
      removed: true,
    });
    assertEquals(await removeEventHandler(deps)({ id: 1 }), {
      id: 1,
      removed: false,
    });
    assertEquals(reported, []);
    assertEquals((await listEventsHandler(deps)({})).rows, []);
  });
});
