// blueprint에 선언한 command의 handler. 선언한 key와 등록한 handler가 같아야 준비가 끝난다.
import { command, CommandRejection, readResult, withRevert } from "@lophn/cap-schedule";
import { createNetClient, type NetClient } from "@lophn/cap-net";
import { createSecretClient, type SecretClient } from "@lophn/cap-secret";
import { openStore, type Store } from "@lophn/cap-store";
import { reportProblem } from "@lophn/cap-problem";
import {
  addEvent,
  type CalendarEvent,
  deleteAllEvents,
  ensureSchema,
  listEvents,
  normalizeStart,
  eventChange,
  revertEvent,
  type RevertInput,
  saveExternal,
} from "./events.ts";
import { createExternalEvent, fetchExternalEvents } from "./external.ts";

export type Deps = {
  openStore: () => Store;
  now: () => string;
  net: NetClient;
  secret: SecretClient;
};

const defaults: Deps = {
  openStore: () => openStore(),
  now: () => new Date().toISOString(),
  net: createNetClient(),
  secret: createSecretClient(),
};

// 저장소를 열고 일을 한다. 저장소가 실패하면 선언한 code로 보고하고 호출자에게는 이유 없는 거절만 돌려준다.
// 보고가 실패해도 업무 응답은 막지 않는다. 입력·DB 내용은 보고에 넣지 않는다. 외부 호출은 이 안에서 하지
// 않는다(저장소를 연 채 기다리지 않는다).
async function withStore<T>(
  deps: Deps,
  name: string,
  work: (store: Store) => T,
): Promise<T> {
  let store: Store | undefined;
  try {
    store = deps.openStore();
    await ensureSchema(store);
    return work(store);
  } catch (error) {
    if (error instanceof CommandRejection) throw error;
    reportProblem("store_unavailable", { command: name });
    throw new CommandRejection("unavailable", "the event store is unavailable");
  } finally {
    store?.close();
  }
}

type EventInput = { title: string; starts_at: string };

function eventInput(input: unknown): EventInput {
  const value = (input ?? {}) as { title?: unknown; starts_at?: unknown };
  const title = String(value.title ?? "").trim();
  if (title === "") {
    throw new CommandRejection("invalid_input", "the event title is empty");
  }
  const startsAt = normalizeStart(value.starts_at);
  if (startsAt === null) {
    throw new CommandRejection(
      "invalid_input",
      "the event start is not a date and time",
    );
  }
  return { title, starts_at: startsAt };
}

export function listEventsHandler(deps: Deps = defaults) {
  return () =>
    withStore(
      deps,
      "list_events",
      (store) =>
        readResult<CalendarEvent>(listEvents(store), {
          coverage: "complete",
          freshness: "fresh",
        }),
    );
}

export function addEventHandler(deps: Deps = defaults) {
  return async (input: unknown) => {
    const event = eventInput(input);
    return await withStore(
      deps,
      "add_event",
      (store) => store.transaction(() => {
        const added = addEvent(store, event.title, event.starts_at, deps.now());
        return withRevert(added, eventChange(store, added.id));
      }),
    );
  };
}

// add_event의 invocation·receipt·revision이 그대로일 때만 만든 일정을 되돌린다.
export function revertEventHandler(deps: Deps = defaults) {
  return async (input: unknown) => {
    const value = input as Partial<RevertInput> | null;
    if (!value || typeof value.invocation !== "string" ||
      typeof value.receipt !== "string" || typeof value.expected_revision !== "string") {
      throw new CommandRejection("invalid_input", "the revert evidence is invalid");
    }
    return await withStore(
      deps,
      "revert_event",
      (store) => revertEvent(store, value as RevertInput),
    );
  };
}

// 외부 캘린더에서 가져와 저장한다. 가져오기만 하고 외부는 바꾸지 않는다.
export function syncEventsHandler(deps: Deps = defaults) {
  return async () => {
    const events = await fetchExternalEvents(deps, "sync_events");
    return await withStore(deps, "sync_events", (store) => {
      const saved = saveExternal(store, events, deps.now());
      return { fetched: events.length, ...saved };
    });
  };
}

// 외부 캘린더에 일정을 만든다. 앱 DB는 바꾸지 않는다.
export function createExternalEventHandler(deps: Deps = defaults) {
  return async (input: unknown) => {
    const event = eventInput(input);
    return {
      event: await createExternalEvent(deps, "create_external_event", event),
    };
  };
}

// 모든 일정을 지운다. 되돌릴 수 없어 사람 확인이 필요한 command다.
export function deleteAllEventsHandler(deps: Deps = defaults) {
  return () =>
    withStore(
      deps,
      "delete_all_events",
      (store) => ({ deleted: deleteAllEvents(store) }),
    );
}

export function registerCommands(deps: Deps = defaults): void {
  command("list_events", listEventsHandler(deps));
  command("add_event", addEventHandler(deps));
  command("revert_event", revertEventHandler(deps));
  command("sync_events", syncEventsHandler(deps));
  command("create_external_event", createExternalEventHandler(deps));
  command("delete_all_events", deleteAllEventsHandler(deps));
}
