// 화면 문구 검사(apps/sdk#R41). 고정 문구의 직접 삽입, 빠진 en key, placeholder 불일치가 여기서 실패한다.
// 화면 언어는 en 하나이고 문구는 message key로만 쓴다. command·screen key는 문구와 별개의 식별자다.
import { assertEquals } from "@std/assert";
import { checkSource, errorsOf } from "@lophn/wording/check";
import { render } from "@lophn/wording/generate";
import blueprint, { makeBlueprint } from "../blueprint.ts";
import { en } from "../src/wording/en.ts";
import { t } from "../src/wording/t.ts";

const root = new URL("../", import.meta.url);
// key의 첫 구간은 이 앱의 screen key와 common이다.
const screens = [...blueprint.screens.map((screen) => screen.key), "common"];

function screenSources(): { path: string; text: string }[] {
  const found: { path: string; text: string }[] = [];
  function visit(directory: URL, prefix: string) {
    for (const entry of Deno.readDirSync(directory)) {
      const path = `${prefix}${entry.name}`;
      if (entry.isDirectory) {
        visit(new URL(`${entry.name}/`, directory), `${path}/`);
      } else if (path.endsWith(".tsx")) {
        found.push({ path, text: Deno.readTextFileSync(new URL(path, root)) });
      }
    }
  }
  visit(new URL("src/screens/", root), "src/screens/");
  return found;
}

Deno.test("wording: screen code has no fixed text and uses only keys of the en catalog", () => {
  const sources = screenSources();
  assertEquals(sources.length > 0, true);
  for (const source of sources) {
    assertEquals(
      errorsOf(checkSource(source.path, source.text, en, { screens })),
      [],
      source.path,
    );
  }
});

Deno.test("wording: the en catalog has valid keys, ICU sentences and no empty value", () => {
  assertEquals(
    errorsOf(
      checkSource("src/wording/en.ts", JSON.stringify(en, null, 2), en, {
        screens,
      }),
    ),
    [],
  );
});

Deno.test("wording: a fixed text in a screen and a key missing from the catalog fail the check", () => {
  const literal = checkSource(
    "a.tsx",
    "export const A = () => <p>Sent</p>;",
    en,
    { screens },
  );
  assertEquals(errorsOf(literal).map((finding) => finding.rule), [
    "literal-text",
  ]);
  const missing = checkSource(
    "b.tsx",
    'const x = t("panel.title.missing");',
    en,
    { screens },
  );
  assertEquals(errorsOf(missing).map((finding) => finding.rule), [
    "unknown-key",
  ]);
  const mismatch = checkSource(
    "c.tsx",
    'const x = t("panel.label.count", { total: 1 });',
    en,
    { screens },
  );
  assertEquals(errorsOf(mismatch).map((finding) => finding.rule), [
    "placeholder-mismatch",
  ]);
  const noEnglish = { ...en, "panel.title.screen": "" };
  assertEquals(
    errorsOf(
      checkSource("en.ts", JSON.stringify(noEnglish), noEnglish, { screens }),
    )
      .map((finding) => finding.rule),
    ["empty-message"],
  );
});

Deno.test("wording: placeholders.ts is generated from the catalog and t formats with ICU", () => {
  const current = Deno.readTextFileSync(
    new URL("src/wording/placeholders.ts", root),
  );
  assertEquals(current, render(en, "deno task wording"));
  assertEquals(t("panel.title.screen"), "Broken");
});

Deno.test("wording: changing catalog text never changes a command or screen key", () => {
  const rewritten = Object.fromEntries(
    Object.entries(en).map(([key, value]) => [key, `${value} (changed)`]),
  ) as unknown as Record<keyof typeof en, string>;
  const changed = makeBlueprint(rewritten);
  assertEquals(
    changed.commands.map((c) => c.key),
    blueprint.commands.map((c) => c.key),
  );
  assertEquals(
    changed.screens.map((s) => s.key),
    blueprint.screens.map((s) => s.key),
  );
  // 문구는 따라 바뀌지만 key는 같다.
  assertEquals(changed.commands[0].label !== blueprint.commands[0].label, true);
});
