// en catalog에서 placeholder 종류를 뽑아 src/wording/placeholders.ts를 만든다.
// 실행: npm run wording [-- --check]. `--check`는 파일이 catalog와 같은지만 본다(tests/wording_test.ts).
import { readFile, writeFile } from "node:fs/promises";
import process from "node:process";

import { render } from "@lophn/wording/generate";
import { en } from "../src/wording/en.ts";

const target = new URL("../src/wording/placeholders.ts", import.meta.url);
const next = render(en, "npm run wording --");

if (process.argv.includes("--check")) {
  const current = await readFile(target, "utf8");
  if (current !== next) {
    console.error(
      "placeholders.ts가 en catalog와 다르다. npm run wording을 돌린다.",
    );
    process.exit(1);
  }
} else {
  await writeFile(target, next);
}
