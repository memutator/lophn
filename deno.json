{
  "workspace": [
    "./packages/*",
    "./packages/sdk/*",
    "./packages/shell/renderer",
    "./tools/wireframes",
    "./packages/design/wording"
  ],
  "lock": {
    "frozen": true
  },
  "imports": {
    "@std/toml": "jsr:@std/toml@1.0.2",
    "@std/yaml": "jsr:@std/yaml@1.3.0",
    "unpdf": "npm:unpdf@1.4.0",
    "zod": "npm:zod@4.6.5",
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "tasks": {
    "check": "deno run --allow-all tools/check.ts",
    "check:full": "deno run --allow-all tools/check.ts --full",
    "wording": "deno run --allow-read --allow-write packages/design/wording/generate.ts",
    "e2e": "deno test --allow-all --no-check tests/e2e",
    "test:live": "deno run --allow-all --env-file=.env tests/live/run.ts",
    "dev": "deno run --allow-all tools/dev.ts dev",
    "dev:core": "deno run --allow-all tools/dev.ts dev:core",
    "dev:mock": "deno run --allow-all tools/dev.ts dev:mock",
    "wireframes": "deno run --allow-read --allow-write --allow-run --allow-env tools/wireframes/build.ts"
  },
  "fmt": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js",
      "**/*.json",
      "**/*.jsonc"
    ]
  },
  "lint": {
    "include": [
      "**/*.ts",
      "**/*.tsx",
      "**/*.js"
    ],
    "rules": {
      "exclude": [
        "no-slow-types"
      ]
    }
  },
  "exclude": [
    ".claude",
    ".dev-data",
    "project-docs",
    "packages/shell/main",
    "packages/shell/preload",
    "dist",
    "node_modules"
  ]
}
