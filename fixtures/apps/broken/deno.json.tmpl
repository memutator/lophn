{
  "imports": {
    "@lophn/app": "./main.ts",
    "@lophn/blueprint": "lophn-sdk:@lophn/blueprint@1.0.0/mod.ts",
    "@lophn/cap-problem": "lophn-sdk:@lophn/cap-problem@1.0.0/mod.ts",
    "@lophn/cap-schedule": "lophn-sdk:@lophn/cap-schedule@1.0.0/mod.ts",
    "@lophn/design": "lophn-sdk:@lophn/design@1.0.0/mod.ts",
    "@lophn/design/base.css": "lophn-sdk:@lophn/design@1.0.0/base.css",
    "@lophn/design/components": "lophn-sdk:@lophn/design@1.0.0/components/mod.ts",
    "@lophn/design/tokens.css": "lophn-sdk:@lophn/design@1.0.0/generated/tokens.css",
    "@lophn/ui-control": "lophn-sdk:@lophn/ui-control@1.0.0/mod.ts",
    "@lophn/ui-layout": "lophn-sdk:@lophn/ui-layout@1.0.0/mod.ts",
    "@lophn/ui-state": "lophn-sdk:@lophn/ui-state@1.0.0/mod.ts",
    "@lophn/wording": "lophn-sdk:@lophn/wording@1.0.0/mod.ts",
    "@lophn/wording/check": "lophn-sdk:@lophn/wording@1.0.0/check.ts",
    "@lophn/wording/generate": "lophn-sdk:@lophn/wording@1.0.0/generate.ts",
    "@luca/esbuild-deno-loader": "jsr:@luca/esbuild-deno-loader@0.11.1",
    "@std/assert": "jsr:@std/assert@1.0.19",
    "@types/react": "npm:@types/react@19.3.0",
    "@types/react/jsx-runtime": "npm:@types/react@19.3.0/jsx-runtime",
    "esbuild": "npm:esbuild@0.28.2",
    "lucide-react": "npm:lucide-react@1.51.0",
    "react": "npm:react@19.3.0",
    "react-dom": "npm:react-dom@19.3.0",
    "react-dom/client": "npm:react-dom@19.3.0/client",
    "react/jsx-runtime": "npm:react@19.3.0/jsx-runtime"
  },
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "ES2023",
      "DOM",
      "deno.ns"
    ],
    "types": [
      "./src/css-modules.d.ts"
    ]
  },
  "tasks": {
    "build": "deno run --allow-read --allow-write --allow-env --allow-run scripts/build-ui.ts",
    "check": "deno check --import-map=.lophn/import-map.json main.ts blueprint.ts src scripts tests",
    "test": "deno test --no-prompt --import-map=.lophn/import-map.json --allow-read --allow-write --allow-env",
    "wording": "deno run --import-map=.lophn/import-map.json --allow-read --allow-write scripts/generate-wording.ts"
  }
}
