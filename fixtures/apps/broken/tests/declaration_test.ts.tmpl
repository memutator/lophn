// blueprint 선언이 이 앱이 하는 일(apps#T26 깨진 앱 fixture)과 맞는지 본다. 선언 자체의 검증과 command
// 등록 일치는 blueprint_test.ts가 본다.
import { assertEquals } from "@std/assert";
import blueprint from "../blueprint.ts";
import { DATA_DIR } from "../src/places.ts";

Deno.test("apps/blueprint#R19: panel 화면은 전체와 패널을 선언한다", () => {
  assertEquals(blueprint.screens.map((s) => [s.key, s.sizes]), [
    ["panel", ["full", "panel"]],
  ]);
});

Deno.test("apps/runtime#R2: run_broken은 깨진 종류를 꼭 받는 read command이고 mark_kind는 write다", () => {
  const by = new Map(blueprint.commands.map((c) => [c.key, c]));
  const run = by.get("run_broken")!;
  assertEquals(run.effect, "read");
  assertEquals([...run.input?.required ?? []].sort(), ["kind"]);
  assertEquals(by.get("mark_kind")?.effect, "write");
  assertEquals(
    blueprint.permissions.map((p) => [p.kind, p.scope]),
    [["fs.write", { path: DATA_DIR, recursive: true }]],
  );
});

Deno.test("apps/runtime#R28: 선언한 problem code는 fixer가 coding_agent와 user로 나뉜다", () => {
  assertEquals(
    blueprint.problem_codes.map((code) => [code.code, code.fixer]).sort(),
    [
      ["fixture_broken", "coding_agent"],
      ["fixture_misconfigured", "user"],
    ],
  );
});
