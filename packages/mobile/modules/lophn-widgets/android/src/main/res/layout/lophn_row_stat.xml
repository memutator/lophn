<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:orientation="horizontal" android:baselineAligned="true" android:layout_marginBottom="4dp">
  <TextView android:id="@+id/lw_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:textSize="22sp" android:lineHeight="26sp" android:letterSpacing="-0.02" android:fontFamily="@font/pretendard_semibold"
    android:textColor="@color/lophn_w_text" android:singleLine="true" />
  <TextView android:id="@+id/lw_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp"
    android:textSize="11sp" android:lineHeight="15sp" android:fontFamily="@font/pretendard_regular" android:textColor="@color/lophn_w_text_secondary" android:singleLine="true" android:ellipsize="end" />
</LinearLayout>
