import { defineApp } from "@lophn/declaration";

// 이 선언이 정본이다. 코드를 바꾸기 전에 먼저 바꾼다.
// 사람에게 보이는 이름·설명은 문장이고, operation·command 이름과 screen의 key는 문장과 별개의 식별자다.
export default defineApp({
  name: "{{TITLE}}",
  description: "A lophn app.",
  // 화면, operation, command, key(단축키), event·subscription(앱 사이의 알림)은 필요할 때 더한다. 화면은 src/screens/<key>/, handler는 src/handlers.ts에 둔다.
  // operation은 화면과 앱 자신이 쓰는 동작이다(agent는 못 본다). command는 agent와 다른 앱이 부르는 의미 단위다.
  // 폰 화면은 `{ key: "orders", label: "Orders", path: "/screens/orders/index.html", places: ["phone"] }`처럼 `phone` 하나만 둔다(`design-app` skill의 Phone screens).
  screens: [
    {
      key: "home",
      label: "{{TITLE}}",
      path: "/screens/home/index.html",
      places: ["tab", "panel", "card"],
    },
  ],
  // 폰에서도 돌릴 앱은 `runs_on: ["computer", "phone"]`, 폰에서만 돌 앱은 `["phone"]`을 더한다. 없으면 컴퓨터에서만 돈다. 규칙은 `design-app` skill의 "Apps that run on the phone"이다.
  operations: [],
  commands: [],
  permissions: [],
  app_connections: [],
  // 정확한 version만 쓴다. package.json의 SDK 의존과 같아야 한다(tests/declaration_test.ts).
  sdk_dependencies: [
    { name: "@lophn/declaration", version: "5.2.0" },
    { name: "@lophn/cap-problem", version: "1.1.0" },
    { name: "@lophn/cap-tool", version: "2.4.0" },
    { name: "@lophn/cap-store", version: "2.1.0" },
    { name: "@lophn/ui", version: "1.2.0" },
    { name: "@lophn/app-ui", version: "2.25.1" },
    { name: "@lophn/agent", version: "1.18.0" },
  ],
});
