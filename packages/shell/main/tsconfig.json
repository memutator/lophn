{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "../preload/**/*.ts", "../ipc/**/*.ts"],
  "exclude": [
    "desktop/core",
    "desktop/main.ts",
    "desktop/wiring",
    "desktop/viewer",
    "page-host"
  ]
}
